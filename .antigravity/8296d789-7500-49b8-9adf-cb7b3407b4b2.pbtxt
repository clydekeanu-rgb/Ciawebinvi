    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { Clock, Sparkles, Wand2, Cake, Music, Gift, Star } from \'lucide-react\';\nimport { TimelineEvent } from \'../types\';\n\ninterface PartyTimelineProps {\n  timeline: TimelineEvent[];\n}\n\nexport const PartyTimeline: React.FC<PartyTimelineProps> = ({ timeline }) => {\n  const getIcon = (name: string) => {\n    switch (name) {\n      case \'Sparkles\':\n        return <Sparkles className=\"w-4 h-4 text-pink-500\" />;\n      case \'Wand2\':\n        return <Wand2 className=\"w-4 h-4 text-cyan-500\" />;\n      case \'Cake\':\n        return <Cake className=\"w-4 h-4 text-amber-500\" />;\n      case \'Music\':\n        return <Music className=\"w-4 h-4 text-purple-500\" />;\n      case \'Gift\':\n        return <Gift className=\"w-4 h-4 text-fuchsia-500\" />;\n      default:\n        return <Star className=\"w-4 h-4 text-yellow-500\" />;\n    }\n  };\n\n  return (\n    <section id=\"party-timeline-section\" className=\"px-4 py-6 max-w-md mx-auto\">\n      <div className=\"bg-white rounded-3xl p-5 shadow-xl border-2 border-teal-200 relative overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between mb-5\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-teal-100 flex items-center justify-center text-teal-600\">\n              <Clock className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-bold font-heading text-slate-800 uppercase tracking-wider\">\n                Party Itinerary &amp; Timeline\n              </h2>\n              <p className=\"text-[11px] text-slate-500 font-medium\">An afternoon filled with dollhouse adventures</p>\n            </div>\n          </div>\n\n          <span className=\"text-[11px] font-bold text-pink-600 bg-pink-50 border border-pink-200 px-2.5 py-1 rounded-full\">\n            5 Fun Stages! \360\237\247\201\n          </span>\n        </div>\n\n        {/* Timeline Itinerary Items */}\n        <div className=\"relative pl-6 space-y-6 before:content-[\'\'] before:absolute before:left-2.5 before:top-2 before:bottom-2 before:w-0.5 before:bg-gradient-to-b before:from-pink-300 before:via-teal-300 before:to-purple-400\">\n          {timeline.map((event) => (\n            <div key={event.id} className=\"relative group\">\n              {/* Bullet Node */}\n              <div className=\"absolute -left-6 top-0 w-6 h-6 rounded-full bg-white border-2 border-pink-400 shadow-xs flex items-center justify-center\">\n                <div className=\"w-2 h-2 rounded-full bg-pink-500\" />\n              </div>\n\n              {/* Event Card */}\n              <div className=\"bg-gradient-to-br from-slate-50 to-pink-50/40 rounded-2xl p-3.5 border border-slate-100 group-hover:border-pink-200 transition-all shadow-2xs\">\n                <div className=\"flex items-center justify-between gap-1 mb-1\">\n                  <span className=\"text-xs font-extrabold text-pink-600 font-heading tracking-wide\">\n                    {event.time}\n                  </span>\n                  <span className=\"text-[10px] font-bold text-slate-600 bg-white px-2 py-0.5 rounded-full border border-slate-200 flex items-center gap-1\">\n                    {getIcon(event.iconName)}\n                    {event.badge}\n                  </span>\n                </div>\n\n                <h3 className=\"text-xs sm:text-sm font-bold font-heading text-slate-800 leading-snug\">\n                  {event.title}\n                </h3>\n\n                <p className=\"text-[11px] text-slate-600 mt-1 leading-relaxed\">\n                  {event.description}\n                </p>\n              </div>\n            </div>\n          ))}\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
