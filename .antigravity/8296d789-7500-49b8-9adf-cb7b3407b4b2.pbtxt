    replacement_chunks {
      target_content: "import React, { useState } from \'react\';\nimport { Settings, Image, Sparkles, MapPin, Calendar, Check, X } from \'lucide-react\';\nimport { PartyDetails } from \'../types\';\n\ninterface EditPartyModalProps {\n  party: PartyDetails;\n  isOpen: boolean;\n  onClose: () => void;\n  onSave: (updatedParty: PartyDetails) => void;\n}\n\nexport const EditPartyModal: React.FC<EditPartyModalProps> = ({\n  party,\n  isOpen,\n  onClose,\n  onSave\n}) => {\n  const [formData, setFormData] = useState<PartyDetails>(party);\n\n  if (!isOpen) return null;\n\n  const presetPhotos = [\n    { label: \'Photo 1 (Cute Party Girl)\', url: \'https://images.unsplash.com/photo-1516627145497-ae6968895b74?auto=format&fit=crop&w=800&q=80\' },\n    { label: \'Photo 2 (Sparkle Smile)\', url: \'https://images.unsplash.com/photo-1485546246426-74dc88dec4d9?auto=format&fit=crop&w=800&q=80\' },\n    { label: \'Photo 3 (Princess Dress)\', url: \'https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=800&q=80\' },\n    { label: \'Photo 4 (Party Hats)\', url: \'https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=800&q=80\' },\n  ];\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onSave(formData);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto\">\n      <div className=\"bg-white rounded-3xl p-5 max-w-md w-full shadow-2xl border-2 border-pink-300 my-8\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-3 border-b border-pink-100 mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center text-pink-600\">\n              <Settings className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-bold font-heading text-slate-800\">\n                Customize Party Invitation\n              </h2>\n              <p className=\"text-[11px] text-slate-500\">Edit celebrant name, photo, date &amp; venue</p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 font-bold text-xs\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-3.5 text-xs\">\n          {/* Celebrant Info */}\n          <div className=\"grid grid-cols-3 gap-2\">\n            <div className=\"col-span-2\">\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Celebrant Name *\n              </label>\n              <input\n                type=\"text\"\n                value={formData.celebrantName}\n                onChange={(e) => setFormData({ ...formData, celebrantName: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n                required\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Age Turning *\n              </label>\n              <input\n                type=\"number\"\n                min=\"1\"\n                max=\"18\"\n                value={formData.celebrantAge}\n                onChange={(e) => setFormData({ ...formData, celebrantAge: parseInt(e.target.value) || 5 })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 text-center font-bold\"\n                required\n              />\n            </div>\n          </div>\n\n          {/* Subtitle / Theme */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n              Event Subtitle / Tagline\n            </label>\n            <input\n              type=\"text\"\n              value={formData.subtitle}\n              onChange={(e) => setFormData({ ...formData, subtitle: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          {/* Celebrant Hero Photo */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1 flex items-center gap-1\">\n              <Image className=\"w-3.5 h-3.5 text-pink-500\" />\n              Celebrant Photo Image URL\n            </label>\n            <input\n              type=\"url\"\n              value={formData.heroImageUrl}\n              onChange={(e) => setFormData({ ...formData, heroImageUrl: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 text-[11px]\"\n              placeholder=\"https://...\"\n            />\n\n            {/* Quick Photo Presets */}\n            <div className=\"mt-1.5 flex items-center gap-1.5 overflow-x-auto pb-1\">\n              {presetPhotos.map((p, idx) => (\n                <button\n                  key={idx}\n                  type=\"button\"\n                  onClick={() => setFormData({ ...formData, heroImageUrl: p.url })}\n                  className=\"w-8 h-8 rounded-lg overflow-hidden border-2 border-pink-200 hover:border-pink-500 shrink-0\"\n                  title={p.label}\n                >\n                  <img src={p.url} alt=\"\" className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Date & Time */}\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Date Display Text\n              </label>\n              <input\n                type=\"text\"\n                value={formData.dateDisplay}\n                onChange={(e) => setFormData({ ...formData, dateDisplay: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Time Display\n              </label>\n              <input\n                type=\"text\"\n                value={formData.timeDisplay}\n                onChange={(e) => setFormData({ ...formData, timeDisplay: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n          </div>\n\n          {/* Venue Details */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1 flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-purple-500\" />\n              Venue Name\n            </label>\n            <input\n              type=\"text\"\n              value={formData.venueName}\n              onChange={(e) => setFormData({ ...formData, venueName: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Address\n              </label>\n              <input\n                type=\"text\"\n                value={formData.venueAddress}\n                onChange={(e) => setFormData({ ...formData, venueAddress: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                City, State, Zip\n              </label>\n              <input\n                type=\"text\"\n                value={formData.venueCityState}\n                onChange={(e) => setFormData({ ...formData, venueCityState: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n          </div>\n\n          {/* Contact phone */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n              Host Contact Phone\n            </label>\n            <input\n              type=\"text\"\n              value={formData.contactPhone}\n              onChange={(e) => setFormData({ ...formData, contactPhone: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          {/* Buttons */}\n          <div className=\"flex items-center gap-2 pt-3 border-t border-slate-100\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"flex-1 py-2.5 font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"flex-1 py-2.5 font-bold text-white bg-gradient-to-r from-pink-500 via-purple-500 to-teal-500 hover:from-pink-600 hover:to-teal-600 rounded-xl shadow flex items-center justify-center gap-1.5\"\n            >\n              <Check className=\"w-4 h-4\" />\n              Save Changes\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};"
      replacement_content: "import React, { useState, useRef } from \'react\';\nimport { Settings, Image, Sparkles, MapPin, Calendar, Check, X, Layers, Upload, Trash2 } from \'lucide-react\';\nimport { PartyDetails } from \'../types\';\n\ninterface EditPartyModalProps {\n  party: PartyDetails;\n  isOpen: boolean;\n  onClose: () => void;\n  onSave: (updatedParty: PartyDetails) => void;\n}\n\nexport const EditPartyModal: React.FC<EditPartyModalProps> = ({\n  party,\n  isOpen,\n  onClose,\n  onSave\n}) => {\n  const [formData, setFormData] = useState<PartyDetails>(party);\n  const wholeImageInputRef = useRef<HTMLInputElement>(null);\n  const cutoutImageInputRef = useRef<HTMLInputElement>(null);\n\n  if (!isOpen) return null;\n\n  const presetPairs = [\n    {\n      label: \'Mia (Default Party Theme)\',\n      wholeUrl: \'https://images.unsplash.com/photo-1516627145497-ae6968895b74?auto=format&fit=crop&w=800&q=80\',\n      cutoutUrl: \'https://png.pngtree.com/png-clipart/20230913/original/pngtree-little-girl-smiling-happy-png-image_11068809.png\'\n    },\n    {\n      label: \'Sparkle Princess Style\',\n      wholeUrl: \'https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=800&q=80\',\n      cutoutUrl: \'https://png.pngtree.com/png-clipart/20231018/original/pngtree-cute-little-girl-wearing-pink-dress-and-smiling-png-image_13349605.png\'\n    },\n    {\n      label: \'Cute Smile & Balloons\',\n      wholeUrl: \'https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=800&q=80\',\n      cutoutUrl: \'\'\n    }\n  ];\n\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>, field: \'heroImageUrl\' | \'heroCutoutImageUrl\') => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      if (typeof event.target?.result === \'string\') {\n        setFormData(prev => ({\n          ...prev,\n          [field]: event.target?.result as string\n        }));\n      }\n    };\n    reader.readAsDataURL(file);\n  };\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onSave(formData);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto\">\n      <div className=\"bg-white rounded-3xl p-5 max-w-lg w-full shadow-2xl border-2 border-pink-300 my-8 max-h-[90vh] overflow-y-auto\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-3 border-b border-pink-100 mb-4 sticky top-0 bg-white z-10\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center text-pink-600\">\n              <Settings className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-bold font-heading text-slate-800\">\n                Customize Party &amp; 2-Image Parallax\n              </h2>\n              <p className=\"text-[11px] text-slate-500\">Add whole background photo + transparent cutout photo</p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 font-bold text-xs cursor-pointer\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-4 text-xs\">\n          {/* Celebrant Info */}\n          <div className=\"grid grid-cols-3 gap-2\">\n            <div className=\"col-span-2\">\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Celebrant Name *\n              </label>\n              <input\n                type=\"text\"\n                value={formData.celebrantName}\n                onChange={(e) => setFormData({ ...formData, celebrantName: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 font-bold\"\n                required\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Age Turning *\n              </label>\n              <input\n                type=\"number\"\n                min=\"1\"\n                max=\"18\"\n                value={formData.celebrantAge}\n                onChange={(e) => setFormData({ ...formData, celebrantAge: parseInt(e.target.value) || 5 })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 text-center font-bold\"\n                required\n              />\n            </div>\n          </div>\n\n          {/* PARALLAX 2-IMAGE SECTION */}\n          <div className=\"p-3.5 rounded-2xl bg-gradient-to-br from-pink-50 via-purple-50 to-indigo-50 border border-purple-200 space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-1.5 font-bold text-purple-900 text-xs\">\n                <Layers className=\"w-4 h-4 text-pink-600\" />\n                <span>2-Image Parallax Configuration</span>\n              </div>\n              <span className=\"text-[10px] text-purple-600 bg-white/80 px-2 py-0.5 rounded-full font-bold border border-purple-200\">\n                2.5D Depth Stage\n              </span>\n            </div>\n\n            {/* Image 1: Whole Image (Background Scene) */}\n            <div className=\"bg-white/90 p-2.5 rounded-xl border border-pink-200 space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-[11px] font-bold text-slate-800 flex items-center gap-1\">\n                  <span className=\"w-4 h-4 rounded-full bg-pink-100 text-pink-600 inline-flex items-center justify-center text-[10px]\">1</span>\n                  Whole Image (Full Scene / Background) *\n                </label>\n                {formData.heroImageUrl && (\n                  <span className=\"text-[10px] text-emerald-600 font-bold\">\342\234\223 Active</span>\n                )}\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  value={formData.heroImageUrl}\n                  onChange={(e) => setFormData({ ...formData, heroImageUrl: e.target.value })}\n                  className=\"flex-1 p-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-pink-400 text-[11px]\"\n                  placeholder=\"Paste whole image URL (https://...)\"\n                  required\n                />\n                <button\n                  type=\"button\"\n                  onClick={() => wholeImageInputRef.current?.click()}\n                  className=\"px-2.5 py-2 bg-pink-100 hover:bg-pink-200 text-pink-700 font-bold text-[11px] rounded-lg flex items-center gap-1 shrink-0 cursor-pointer\"\n                  title=\"Upload Whole Image file\"\n                >\n                  <Upload className=\"w-3.5 h-3.5\" />\n                  <span>Upload</span>\n                </button>\n                <input\n                  ref={wholeImageInputRef}\n                  type=\"file\"\n                  accept=\"image/*\"\n                  onChange={(e) => handleFileUpload(e, \'heroImageUrl\')}\n                  className=\"hidden\"\n                />\n              </div>\n\n              {/* Preview */}\n              {formData.heroImageUrl && (\n                <div className=\"h-16 w-full rounded-lg overflow-hidden border border-slate-200 relative bg-slate-100\">\n                  <img src={formData.heroImageUrl} alt=\"Whole scene preview\" className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n                  <div className=\"absolute bottom-1 left-2 text-[9px] bg-black/60 text-white px-1.5 py-0.5 rounded font-mono\">\n                    Background Layer\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Image 2: Cutout Image (Foreground with No Background) */}\n            <div className=\"bg-white/90 p-2.5 rounded-xl border border-purple-200 space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <label className=\"text-[11px] font-bold text-slate-800 flex items-center gap-1\">\n                  <span className=\"w-4 h-4 rounded-full bg-purple-100 text-purple-600 inline-flex items-center justify-center text-[10px]\">2</span>\n                  Subject Image (No Background / Transparent PNG)\n                </label>\n                {formData.heroCutoutImageUrl ? (\n                  <button\n                    type=\"button\"\n                    onClick={() => setFormData({ ...formData, heroCutoutImageUrl: \'\' })}\n                    className=\"text-[10px] text-rose-500 hover:underline flex items-center gap-0.5 cursor-pointer\"\n                  >\n                    <Trash2 className=\"w-3 h-3\" /> Remove\n                  </button>\n                ) : (\n                  <span className=\"text-[10px] text-slate-400\">Optional (Recommended)</span>\n                )}\n              </div>\n\n              <div className=\"flex items-center gap-2\">\n                <input\n                  type=\"text\"\n                  value={formData.heroCutoutImageUrl || \'\'}\n                  onChange={(e) => setFormData({ ...formData, heroCutoutImageUrl: e.target.value })}\n                  className=\"flex-1 p-2 rounded-lg border border-slate-200 focus:ring-2 focus:ring-purple-400 text-[11px]\"\n                  placeholder=\"Paste transparent cutout PNG URL (https://...)\"\n                />\n                <button\n                  type=\"button\"\n                  onClick={() => cutoutImageInputRef.current?.click()}\n                  className=\"px-2.5 py-2 bg-purple-100 hover:bg-purple-200 text-purple-700 font-bold text-[11px] rounded-lg flex items-center gap-1 shrink-0 cursor-pointer\"\n                  title=\"Upload Cutout PNG file\"\n                >\n                  <Upload className=\"w-3.5 h-3.5\" />\n                  <span>Upload PNG</span>\n                </button>\n                <input\n                  ref={cutoutImageInputRef}\n                  type=\"file\"\n                  accept=\"image/png,image/webp,image/*\"\n                  onChange={(e) => handleFileUpload(e, \'heroCutoutImageUrl\')}\n                  className=\"hidden\"\n                />\n              </div>\n\n              {/* Preview with checkered transparent background */}\n              {formData.heroCutoutImageUrl && (\n                <div className=\"h-16 w-full rounded-lg overflow-hidden border border-purple-200 relative bg-[radial-gradient(#cbd5e1_1px,transparent_1px)] [background-size:8px_8px] bg-slate-100 flex items-center justify-center\">\n                  <img src={formData.heroCutoutImageUrl} alt=\"Subject cutout preview\" className=\"h-full object-contain filter drop-shadow\" referrerPolicy=\"no-referrer\" />\n                  <div className=\"absolute bottom-1 left-2 text-[9px] bg-purple-900/70 text-white px-1.5 py-0.5 rounded font-mono\">\n                    Foreground Cutout Layer\n                  </div>\n                </div>\n              )}\n            </div>\n\n            {/* Quick Demo Presets */}\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-600 mb-1\">\n                Quick 2-Image Parallax Presets:\n              </label>\n              <div className=\"flex items-center gap-2 overflow-x-auto pb-1\">\n                {presetPairs.map((p, idx) => (\n                  <button\n                    key={idx}\n                    type=\"button\"\n                    onClick={() => setFormData({\n                      ...formData,\n                      heroImageUrl: p.wholeUrl,\n                      heroCutoutImageUrl: p.cutoutUrl\n                    })}\n                    className=\"px-2.5 py-1.5 rounded-lg bg-white border border-pink-200 hover:border-pink-500 text-[10px] font-bold text-slate-700 whitespace-nowrap shadow-xs cursor-pointer\"\n                  >\n                    {p.label}\n                  </button>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Subtitle / Theme */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n              Event Subtitle / Tagline\n            </label>\n            <input\n              type=\"text\"\n              value={formData.subtitle}\n              onChange={(e) => setFormData({ ...formData, subtitle: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          {/* Date & Time */}\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Date Display Text\n              </label>\n              <input\n                type=\"text\"\n                value={formData.dateDisplay}\n                onChange={(e) => setFormData({ ...formData, dateDisplay: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Time Display\n              </label>\n              <input\n                type=\"text\"\n                value={formData.timeDisplay}\n                onChange={(e) => setFormData({ ...formData, timeDisplay: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n          </div>\n\n          {/* Venue Details */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1 flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-purple-500\" />\n              Venue Name\n            </label>\n            <input\n              type=\"text\"\n              value={formData.venueName}\n              onChange={(e) => setFormData({ ...formData, venueName: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Address\n              </label>\n              <input\n                type=\"text\"\n                value={formData.venueAddress}\n                onChange={(e) => setFormData({ ...formData, venueAddress: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                City, State, Zip\n              </label>\n              <input\n                type=\"text\"\n                value={formData.venueCityState}\n                onChange={(e) => setFormData({ ...formData, venueCityState: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n          </div>\n\n          {/* Contact phone */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n              Host Contact Phone\n            </label>\n            <input\n              type=\"text\"\n              value={formData.contactPhone}\n              onChange={(e) => setFormData({ ...formData, contactPhone: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          {/* Buttons */}\n          <div className=\"flex items-center gap-2 pt-3 border-t border-slate-100\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"flex-1 py-2.5 font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl cursor-pointer\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"flex-1 py-2.5 font-bold text-white bg-gradient-to-r from-pink-500 via-purple-500 to-teal-500 hover:from-pink-600 hover:to-teal-600 rounded-xl shadow flex items-center justify-center gap-1.5 cursor-pointer\"\n            >\n              <Check className=\"w-4 h-4\" />\n              Save Changes\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
