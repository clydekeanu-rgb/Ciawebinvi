  file_change {
    absolute_path_uri: "file:///src/components/RsvpSection.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { PartyPopper, Check, Users, Sparkles, Send, Heart, Utensils, MessageSquare } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { PartyDetails, RsvpSubmission } from \'../types\';\nimport { audioEngine } from \'../utils/audioSynth\';\n\ninterface RsvpSectionProps {\n  party: PartyDetails;\n  rsvps: RsvpSubmission[];\n  onSubmitRsvp: (rsvp: RsvpSubmission) => void;\n}\n\nexport const RsvpSection: React.FC<RsvpSectionProps> = ({\n  party,\n  rsvps,\n  onSubmitRsvp\n}) => {\n  const [guestName, setGuestName] = useState(\'\');\n  const [emailOrPhone, setEmailOrPhone] = useState(\'\');\n  const [attending, setAttending] = useState<\'yes\' | \'no\'>(\'yes\');\n  const [adultsCount, setAdultsCount] = useState(1);\n  const [kidsCount, setKidsCount] = useState(1);\n  const [kidsNames, setKidsNames] = useState(\'\');\n  const [dietary, setDietary] = useState(\'\');\n  const [wish, setWish] = useState(\'\');\n  const [isSubmitted, setIsSubmitted] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'form\' | \'guestlist\'>(\'form\');\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!guestName.trim()) return;\n\n    const newRsvp: RsvpSubmission = {\n      id: `rsvp-${Date.now()}`,\n      guestName: guestName.trim(),\n      emailOrPhone: emailOrPhone.trim(),\n      attending,\n      adultsCount: attending === \'yes\' ? adultsCount : 0,\n      kidsCount: attending === \'yes\' ? kidsCount : 0,\n      kidsNames: kidsNames.trim(),\n      dietaryRestrictions: dietary.trim(),\n      birthdayWish: wish.trim(),\n      submittedAt: new Date().toLocaleDateString()\n    };\n\n    onSubmitRsvp(newRsvp);\n    setIsSubmitted(true);\n\n    if (attending === \'yes\') {\n      audioEngine.playConfettiPopSound();\n      confetti({\n        particleCount: 120,\n        spread: 80,\n        origin: { y: 0.8 },\n        colors: [\'#FF69B4\', \'#A855F7\', \'#38BDF8\', \'#F59E0B\']\n      });\n    }\n  };\n\n  const totalAttendingGuests = rsvps\n    .filter(r => r.attending === \'yes\')\n    .reduce((sum, r) => sum + r.adultsCount + r.kidsCount, 0);\n\n  const totalKidsCount = rsvps\n    .filter(r => r.attending === \'yes\')\n    .reduce((sum, r) => sum + r.kidsCount, 0);\n\n  return (\n    <section id=\"rsvp-section\" className=\"px-4 py-6 max-w-md mx-auto\">\n      <div className=\"bg-white rounded-3xl p-5 shadow-xl border-2 border-pink-300 relative overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center text-pink-600\">\n              <PartyPopper className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-bold font-heading text-slate-800 uppercase tracking-wider\">\n                RSVP for the Party\n              </h2>\n              <p className=\"text-[11px] text-slate-500 font-medium\">\n                Please reply by {party.rsvpDeadline}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-1 bg-pink-50 p-1 rounded-xl border border-pink-100 text-xs font-bold\">\n            <button\n              onClick={() => setActiveTab(\'form\')}\n              className={`px-2.5 py-1 rounded-lg transition-all ${\n                activeTab === \'form\' ? \'bg-pink-500 text-white shadow-xs\' : \'text-slate-600 hover:text-pink-600\'\n              }`}\n            >\n              Reply\n            </button>\n            <button\n              onClick={() => setActiveTab(\'guestlist\')}\n              className={`px-2.5 py-1 rounded-lg transition-all flex items-center gap-1 ${\n                activeTab === \'guestlist\' ? \'bg-pink-500 text-white shadow-xs\' : \'text-slate-600 hover:text-pink-600\'\n              }`}\n            >\n              <span>Guests</span>\n              <span className=\"bg-white/90 text-pink-700 text-[10px] px-1.5 py-0.2 rounded-full\">\n                {rsvps.filter(r => r.attending === \'yes\').length}\n              </span>\n            </button>\n          </div>\n        </div>\n\n        {activeTab === \'form\' ? (\n          isSubmitted ? (\n            <div className=\"text-center py-6 px-3 bg-gradient-to-b from-pink-50 to-purple-50 rounded-2xl border border-pink-200\">\n              <div className=\"w-14 h-14 mx-auto rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mb-3 shadow-inner\">\n                <Check className=\"w-8 h-8\" />\n              </div>\n              <h3 className=\"text-base font-bold font-heading text-slate-800\">\n                {attending === \'yes\' ? \"Woohoo! You\'re on the Guest List! \360\237\216\211\" : \"Thank you for letting us know! \360\237\222\225\"}\n              </h3>\n              <p className=\"text-xs text-slate-600 mt-1 max-w-xs mx-auto\">\n                {attending === \'yes\'\n                  ? `We are so excited to celebrate ${party.celebrantName}\'s 5th birthday with you!`\n                  : `We\'ll miss you at the Dollhouse, but thank you for your sweet wishes!`}\n              </p>\n\n              <button\n                onClick={() => setIsSubmitted(false)}\n                className=\"mt-4 text-xs font-bold text-pink-600 hover:text-pink-700 underline\"\n              >\n                Submit another response / update RSVP\n              </button>\n            </div>\n          ) : (\n            <form onSubmit={handleSubmit} className=\"space-y-3.5 text-xs\">\n              {/* Attending choice pills */}\n              <div className=\"grid grid-cols-2 gap-2\">\n                <button\n                  type=\"button\"\n                  onClick={() => setAttending(\'yes\')}\n                  className={`p-3 rounded-2xl font-bold border flex flex-col items-center justify-center transition-all ${\n                    attending === \'yes\'\n                      ? \'bg-gradient-to-r from-pink-500 to-rose-500 text-white border-pink-500 shadow-md shadow-pink-200\'\n                      : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-pink-50\'\n                  }`}\n                >\n                  <span className=\"text-base mb-0.5\">\360\237\216\211</span>\n                  <span>Yes, We&apos;ll Be There!</span>\n                </button>\n\n                <button\n                  type=\"button\"\n                  onClick={() => setAttending(\'no\')}\n                  className={`p-3 rounded-2xl font-bold border flex flex-col items-center justify-center transition-all ${\n                    attending === \'no\'\n                      ? \'bg-gradient-to-r from-slate-600 to-slate-700 text-white border-slate-600 shadow-md\'\n                      : \'bg-slate-50 text-slate-700 border-slate-200 hover:bg-slate-100\'\n                  }`}\n                >\n                  <span className=\"text-base mb-0.5\">\360\237\222\214</span>\n                  <span>Sadly Can&apos;t Make It</span>\n                </button>\n              </div>\n\n              {/* Guest Full Name */}\n              <div>\n                <label className=\"block text-[11px] font-bold text-slate-700 mb-1\">\n                  Family / Guest Name *\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. The Anderson Family / Jessica\"\n                  value={guestName}\n                  onChange={(e) => setGuestName(e.target.value)}\n                  className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                  required\n                />\n              </div>\n\n              {/* Phone / Email */}\n              <div>\n                <label className=\"block text-[11px] font-bold text-slate-700 mb-1\">\n                  Phone or Email (For party updates)\n                </label>\n                <input\n                  type=\"text\"\n                  placeholder=\"e.g. (555) 123-4567 or email@example.com\"\n                  value={emailOrPhone}\n                  onChange={(e) => setEmailOrPhone(e.target.value)}\n                  className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                />\n              </div>\n\n              {attending === \'yes\' && (\n                <>\n                  {/* Guest Counters */}\n                  <div className=\"grid grid-cols-2 gap-3 bg-pink-50/70 p-3 rounded-2xl border border-pink-100\">\n                    <div>\n                      <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                        Number of Kids \360\237\247\222\n                      </label>\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          type=\"button\"\n                          onClick={() => setKidsCount(Math.max(0, kidsCount - 1))}\n                          className=\"w-7 h-7 rounded-lg bg-white border border-pink-200 font-bold text-pink-600 flex items-center justify-center hover:bg-pink-100\"\n                        >\n                          -\n                        </button>\n                        <span className=\"font-bold text-sm text-slate-800 w-4 text-center\">\n                          {kidsCount}\n                        </span>\n                        <button\n                          type=\"button\"\n                          onClick={() => setKidsCount(kidsCount + 1)}\n                          className=\"w-7 h-7 rounded-lg bg-white border border-pink-200 font-bold text-pink-600 flex items-center justify-center hover:bg-pink-100\"\n                        >\n                          +\n                        </button>\n                      </div>\n                    </div>\n\n                    <div>\n                      <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                        Number of Adults \360\237\247\221\n                      </label>\n                      <div className=\"flex items-center gap-2\">\n                        <button\n                          type=\"button\"\n                          onClick={() => setAdultsCount(Math.max(0, adultsCount - 1))}\n                          className=\"w-7 h-7 rounded-lg bg-white border border-pink-200 font-bold text-pink-600 flex items-center justify-center hover:bg-pink-100\"\n                        >\n                          -\n                        </button>\n                        <span className=\"font-bold text-sm text-slate-800 w-4 text-center\">\n                          {adultsCount}\n                        </span>\n                        <button\n                          type=\"button\"\n                          onClick={() => setAdultsCount(adultsCount + 1)}\n                          className=\"w-7 h-7 rounded-lg bg-white border border-pink-200 font-bold text-pink-600 flex items-center justify-center hover:bg-pink-100\"\n                        >\n                          +\n                        </button>\n                      </div>\n                    </div>\n                  </div>\n\n                  {/* Children\'s Names */}\n                  <div>\n                    <label className=\"block text-[11px] font-bold text-slate-700 mb-1\">\n                      Children&apos;s Names &amp; Ages (Optional)\n                    </label>\n                    <input\n                      type=\"text\"\n                      placeholder=\"e.g. Leo (age 5), Maya (age 3)\"\n                      value={kidsNames}\n                      onChange={(e) => setKidsNames(e.target.value)}\n                      className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                    />\n                  </div>\n\n                  {/* Dietary notes */}\n                  <div>\n                    <label className=\"block text-[11px] font-bold text-slate-700 mb-1 flex items-center gap-1\">\n                      <Utensils className=\"w-3 h-3 text-pink-500\" />\n                      Dietary Restrictions or Allergies\n                    </label>\n                    <input\n                      type=\"text\"\n                      placeholder=\"e.g. Peanut allergy, gluten-free, vegan\"\n                      value={dietary}\n                      onChange={(e) => setDietary(e.target.value)}\n                      className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                    />\n                  </div>\n                </>\n              )}\n\n              {/* Birthday wish */}\n              <div>\n                <label className=\"block text-[11px] font-bold text-slate-700 mb-1 flex items-center gap-1\">\n                  <MessageSquare className=\"w-3 h-3 text-purple-500\" />\n                  Birthday Wish for {party.celebrantName} \360\237\222\225\n                </label>\n                <textarea\n                  rows={2}\n                  placeholder={`Send a cute birthday note to ${party.celebrantName}...`}\n                  value={wish}\n                  onChange={(e) => setWish(e.target.value)}\n                  className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                />\n              </div>\n\n              <button\n                type=\"submit\"\n                className=\"w-full py-3 rounded-xl bg-gradient-to-r from-pink-500 via-purple-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-bold text-sm shadow-lg shadow-pink-200 flex items-center justify-center gap-2 transition-all active:scale-98\"\n              >\n                <Send className=\"w-4 h-4\" />\n                Confirm RSVP\n              </button>\n            </form>\n          )\n        ) : (\n          /* Guest List View */\n          <div className=\"space-y-3\">\n            {/* Stats bar */}\n            <div className=\"grid grid-cols-2 gap-2 text-center text-xs\">\n              <div className=\"bg-pink-50 p-2.5 rounded-2xl border border-pink-200\">\n                <span className=\"text-[10px] text-pink-600 font-bold block uppercase\">Total Guests</span>\n                <span className=\"text-xl font-extrabold text-pink-700\">{totalAttendingGuests}</span>\n              </div>\n              <div className=\"bg-purple-50 p-2.5 rounded-2xl border border-purple-200\">\n                <span className=\"text-[10px] text-purple-600 font-bold block uppercase\">Kids Coming</span>\n                <span className=\"text-xl font-extrabold text-purple-700\">{totalKidsCount}</span>\n              </div>\n            </div>\n\n            <div className=\"max-h-60 overflow-y-auto space-y-2 pr-1\">\n              {rsvps.map((rsvp) => (\n                <div\n                  key={rsvp.id}\n                  className={`p-2.5 rounded-xl border flex items-center justify-between text-xs ${\n                    rsvp.attending === \'yes\'\n                      ? \'bg-pink-50/50 border-pink-100\'\n                      : \'bg-slate-50 border-slate-200 opacity-60\'\n                  }`}\n                >\n                  <div>\n                    <p className=\"font-bold text-slate-800\">{rsvp.guestName}</p>\n                    {rsvp.attending === \'yes\' ? (\n                      <p className=\"text-[11px] text-pink-600\">\n                        {rsvp.kidsCount} kid{rsvp.kidsCount !== 1 ? \'s\' : \'\'}, {rsvp.adultsCount} adult{rsvp.adultsCount !== 1 ? \'s\' : \'\'}\n                        {rsvp.kidsNames ? ` (${rsvp.kidsNames})` : \'\'}\n                      </p>\n                    ) : (\n                      <p className=\"text-[10px] text-slate-500\">Sent regrets</p>\n                    )}\n                  </div>\n\n                  <span\n                    className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${\n                      rsvp.attending === \'yes\'\n                        ? \'bg-emerald-100 text-emerald-700\'\n                        : \'bg-slate-200 text-slate-600\'\n                    }`}\n                  >\n                    {rsvp.attending === \'yes\' ? \'Attending\' : \'Can\342\200\231t make it\'}\n                  </span>\n                </div>\n              ))}\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n"
    }
