    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Gift, CheckCircle, ExternalLink, Heart, Sparkles, Plus, UserCheck, Shirt } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { GiftItem, PartyDetails } from \'../types\';\n\ninterface GiftRegistrySectionProps {\n  party: PartyDetails;\n  gifts: GiftItem[];\n  onToggleClaimGift: (giftId: string, claimedBy?: string) => void;\n  onAddNewGift: (newGift: GiftItem) => void;\n}\n\nexport const GiftRegistrySection: React.FC<GiftRegistrySectionProps> = ({\n  party,\n  gifts,\n  onToggleClaimGift,\n  onAddNewGift\n}) => {\n  const [selectedCategory, setSelectedCategory] = useState<string>(\'all\');\n  const [claimingGiftId, setClaimingGiftId] = useState<string | null>(null);\n  const [claimerName, setClaimerName] = useState(\'\');\n  const [showAddModal, setShowAddModal] = useState(false);\n  const [newItemTitle, setNewItemTitle] = useState(\'\');\n  const [newItemCategory, setNewItemCategory] = useState<GiftItem[\'category\']>(\'dollhouse\');\n  const [newItemDesc, setNewItemDesc] = useState(\'\');\n  const [newItemPrice, setNewItemPrice] = useState(\'$20 - $30\');\n\n  const categories = [\n    { id: \'all\', label: \'All Ideas\' },\n    { id: \'dollhouse\', label: \'\360\237\220\261 Dollhouse\' },\n    { id: \'crafts\', label: \'\360\237\216\250 Arts & Crafts\' },\n    { id: \'dressup\', label: \'\360\237\221\227 Dress Up\' },\n    { id: \'books-stem\', label: \'\360\237\223\232 Books & Toys\' },\n    { id: \'favorites\', label: \'\342\255\220 Favorites\' },\n  ];\n\n  const filteredGifts = gifts.filter((gift) => {\n    if (selectedCategory === \'all\') return true;\n    if (selectedCategory === \'favorites\') return gift.isTopPick;\n    return gift.category === selectedCategory;\n  });\n\n  const handleStartClaim = (gift: GiftItem) => {\n    if (gift.isClaimed) {\n      // Unclaim\n      if (confirm(`Unclaim \"${gift.title}\" so another guest can purchase it?`)) {\n        onToggleClaimGift(gift.id);\n      }\n    } else {\n      setClaimingGiftId(gift.id);\n      setClaimerName(\'\');\n    }\n  };\n\n  const handleConfirmClaim = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!claimingGiftId) return;\n\n    const name = claimerName.trim() || \'A sweet guest\';\n    onToggleClaimGift(claimingGiftId, name);\n\n    confetti({\n      particleCount: 50,\n      spread: 60,\n      origin: { y: 0.7 },\n      colors: [\'#FF69B4\', \'#A855F7\', \'#38BDF8\']\n    });\n\n    setClaimingGiftId(null);\n    setClaimerName(\'\');\n  };\n\n  const handleCreateNewGift = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newItemTitle.trim()) return;\n\n    const newGift: GiftItem = {\n      id: `gift-${Date.now()}`,\n      title: newItemTitle.trim(),\n      category: newItemCategory,\n      description: newItemDesc.trim() || \"A wonderful birthday surprise for Mia!\",\n      priceRange: newItemPrice,\n      imageUrl: \'https://images.unsplash.com/photo-1513151233558-d860c5398176?auto=format&fit=crop&w=400&q=80\',\n      suggestedStore: \'Amazon / Target\',\n      searchUrl: `https://www.google.com/search?q=${encodeURIComponent(newItemTitle)}`,\n      isClaimed: false,\n      isTopPick: false\n    };\n\n    onAddNewGift(newGift);\n    setShowAddModal(false);\n    setNewItemTitle(\'\');\n    setNewItemDesc(\'\');\n  };\n\n  return (\n    <section id=\"gift-registry-section\" className=\"px-4 py-6 max-w-md mx-auto\">\n      <div className=\"bg-white rounded-3xl p-5 shadow-xl border-2 border-pink-200 relative\">\n        {/* Section Header */}\n        <div className=\"flex items-center justify-between mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center text-pink-500\">\n              <Gift className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-bold font-heading text-slate-800 uppercase tracking-wider\">\n                {party.celebrantName}&apos;s Gift Ideas &amp; Wishlist\n              </h2>\n              <p className=\"text-[11px] text-slate-500 font-medium\">Favorite toys, dollhouse surprises &amp; sizes</p>\n            </div>\n          </div>\n\n          <button\n            onClick={() => setShowAddModal(true)}\n            className=\"text-[11px] font-bold text-pink-600 bg-pink-50 hover:bg-pink-100 border border-pink-200 px-2.5 py-1 rounded-full flex items-center gap-1 transition-colors\"\n            title=\"Add Gift Suggestion\"\n          >\n            <Plus className=\"w-3 h-3\" />\n            Add Item\n          </button>\n        </div>\n\n        {/* Note from parents banner */}\n        <div className=\"bg-gradient-to-r from-pink-50 via-purple-50 to-pink-50 rounded-2xl p-3 border border-pink-100 mb-4 text-xs text-slate-700\">\n          <p className=\"flex items-center gap-1 font-semibold text-pink-800 mb-1\">\n            <Heart className=\"w-3.5 h-3.5 fill-pink-500 text-pink-500\" />\n            Your presence is the greatest gift!\n          </p>\n          <p className=\"text-[11px] text-slate-600 leading-relaxed\">\n            If you wish to bring a gift, here is a curated list of things {party.celebrantName} loves. You can tap &quot;I&apos;m Gifting This&quot; to reserve an item so others don&apos;t duplicate it.\n          </p>\n        </div>\n\n        {/* Celebrant Sizes & Favorites Quick Cheat Sheet */}\n        <div className=\"bg-slate-50 rounded-2xl p-3.5 border border-slate-200/80 mb-5\">\n          <div className=\"flex items-center gap-1.5 text-xs font-bold text-slate-800 mb-2\">\n            <Shirt className=\"w-3.5 h-3.5 text-purple-600\" />\n            <span>Size &amp; Favorites Cheat Sheet</span>\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-2 text-[11px] mb-2.5\">\n            <div className=\"bg-white p-2 rounded-xl border border-slate-100 shadow-2xs\">\n              <span className=\"text-slate-400 block text-[10px]\">Clothing Size:</span>\n              <strong className=\"text-slate-700\">{party.childSizes.clothing}</strong>\n            </div>\n            <div className=\"bg-white p-2 rounded-xl border border-slate-100 shadow-2xs\">\n              <span className=\"text-slate-400 block text-[10px]\">Shoe Size:</span>\n              <strong className=\"text-slate-700\">{party.childSizes.shoes}</strong>\n            </div>\n          </div>\n\n          <div className=\"space-y-1.5 text-[11px]\">\n            <div>\n              <span className=\"text-slate-500 font-medium\">Favorite Colors: </span>\n              <span className=\"text-slate-700 font-semibold\">{party.childSizes.favoriteColors.join(\', \')}</span>\n            </div>\n            <div>\n              <span className=\"text-slate-500 font-medium\">Favorite Characters: </span>\n              <span className=\"text-slate-700 font-semibold\">{party.childSizes.favoriteCharacters.join(\', \')}</span>\n            </div>\n          </div>\n        </div>\n\n        {/* Category Pills Slider */}\n        <div className=\"flex items-center gap-1.5 overflow-x-auto pb-3 mb-3 no-scrollbar\">\n          {categories.map((cat) => (\n            <button\n              key={cat.id}\n              onClick={() => setSelectedCategory(cat.id)}\n              className={`px-3 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all ${\n                selectedCategory === cat.id\n                  ? \'bg-gradient-to-r from-pink-500 to-purple-600 text-white shadow-sm scale-102\'\n                  : \'bg-slate-100 hover:bg-slate-200 text-slate-600\'\n              }`}\n            >\n              {cat.label}\n            </button>\n          ))}\n        </div>\n\n        {/* Gift Items List */}\n        <div className=\"space-y-3\">\n          {filteredGifts.map((gift) => (\n            <div\n              key={gift.id}\n              className={`rounded-2xl p-3.5 border transition-all flex flex-col justify-between ${\n                gift.isClaimed\n                  ? \'bg-slate-50/90 border-slate-200 opacity-80\'\n                  : \'bg-white border-pink-100 shadow-sm hover:border-pink-300 hover:shadow-md\'\n              }`}\n            >\n              <div className=\"flex items-start gap-3\">\n                {/* Gift Photo / Thumbnail */}\n                <div className=\"relative w-16 h-16 rounded-xl overflow-hidden bg-pink-50 shrink-0 border border-pink-100\">\n                  <img\n                    src={gift.imageUrl}\n                    alt={gift.title}\n                    className=\"w-full h-full object-cover\"\n                    referrerPolicy=\"no-referrer\"\n                  />\n                  {gift.isTopPick && (\n                    <div className=\"absolute top-0 right-0 bg-yellow-400 text-yellow-950 text-[9px] font-bold px-1 rounded-bl\">\n                      \342\230\205 Top\n                    </div>\n                  )}\n                </div>\n\n                {/* Gift Info */}\n                <div className=\"flex-1 min-w-0\">\n                  <div className=\"flex items-start justify-between gap-1\">\n                    <h3 className=\"font-heading font-bold text-xs sm:text-sm text-slate-800 leading-snug\">\n                      {gift.title}\n                    </h3>\n                  </div>\n\n                  <p className=\"text-[11px] text-slate-500 line-clamp-2 mt-0.5 leading-relaxed\">\n                    {gift.description}\n                  </p>\n\n                  <div className=\"flex items-center gap-2 mt-1.5 flex-wrap\">\n                    <span className=\"text-[10px] font-bold text-pink-600 bg-pink-50 px-2 py-0.5 rounded-md border border-pink-100\">\n                      {gift.priceRange}\n                    </span>\n                    <span className=\"text-[10px] text-slate-500\">\n                      {gift.suggestedStore}\n                    </span>\n                  </div>\n                </div>\n              </div>\n\n              {/* Action Buttons Row */}\n              <div className=\"mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between gap-2\">\n                <a\n                  href={gift.searchUrl}\n                  target=\"_blank\"\n                  rel=\"noreferrer\"\n                  className=\"text-[11px] font-bold text-slate-600 hover:text-pink-600 inline-flex items-center gap-1 transition-colors\"\n                >\n                  <ExternalLink className=\"w-3 h-3\" />\n                  Find in Store\n                </a>\n\n                {gift.isClaimed ? (\n                  <button\n                    onClick={() => handleStartClaim(gift)}\n                    className=\"text-[11px] font-bold text-emerald-700 bg-emerald-50 hover:bg-emerald-100 px-3 py-1.5 rounded-xl border border-emerald-200 inline-flex items-center gap-1 transition-colors\"\n                  >\n                    <CheckCircle className=\"w-3.5 h-3.5 text-emerald-500\" />\n                    <span>Claimed by {gift.claimedByName || \'Guest\'}</span>\n                  </button>\n                ) : (\n                  <button\n                    onClick={() => handleStartClaim(gift)}\n                    className=\"text-[11px] font-bold text-white bg-gradient-to-r from-pink-500 to-purple-500 hover:from-pink-600 hover:to-purple-600 px-3 py-1.5 rounded-xl shadow-xs inline-flex items-center gap-1 transition-all active:scale-95\"\n                  >\n                    <Gift className=\"w-3.5 h-3.5\" />\n                    I&apos;m Gifting This!\n                  </button>\n                )}\n              </div>\n            </div>\n          ))}\n\n          {filteredGifts.length === 0 && (\n            <div className=\"text-center py-8 text-slate-500 text-xs\">\n              No items in this category yet.\n            </div>\n          )}\n        </div>\n\n        {/* Claim Modal Prompt */}\n        {claimingGiftId && (\n          <div className=\"fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4\">\n            <div className=\"bg-white rounded-3xl p-5 max-w-sm w-full shadow-2xl border-2 border-pink-300 animate-in zoom-in-95 duration-150\">\n              <div className=\"flex items-center justify-between mb-3\">\n                <div className=\"flex items-center gap-1.5 font-heading font-bold text-sm text-slate-800\">\n                  <UserCheck className=\"w-4 h-4 text-pink-500\" />\n                  Claim Birthday Gift\n                </div>\n                <button\n                  onClick={() => setClaimingGiftId(null)}\n                  className=\"text-xs font-bold text-slate-400 hover:text-slate-600\"\n                >\n                  \342\234\225\n                </button>\n              </div>\n\n              <p className=\"text-xs text-slate-600 mb-3\">\n                Enter your name so other party guests know this surprise is covered!\n              </p>\n\n              <form onSubmit={handleConfirmClaim} className=\"space-y-3\">\n                <input\n                  type=\"text\"\n                  placeholder=\"Your Name (e.g. Auntie Sarah)\"\n                  value={claimerName}\n                  onChange={(e) => setClaimerName(e.target.value)}\n                  className=\"w-full text-xs p-3 rounded-xl border border-pink-200 focus:outline-hidden focus:ring-2 focus:ring-pink-400\"\n                  autoFocus\n                  required\n                />\n\n                <div className=\"flex items-center gap-2 pt-1\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setClaimingGiftId(null)}\n                    className=\"flex-1 py-2 text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"flex-1 py-2 text-xs font-bold text-white bg-gradient-to-r from-pink-500 to-purple-600 rounded-xl shadow\"\n                  >\n                    Confirm Claim \360\237\216\201\n                  </button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n\n        {/* Add Gift Suggestion Modal */}\n        {showAddModal && (\n          <div className=\"fixed inset-0 z-50 bg-black/50 backdrop-blur-xs flex items-center justify-center p-4\">\n            <div className=\"bg-white rounded-3xl p-5 max-w-sm w-full shadow-2xl border-2 border-pink-300 animate-in zoom-in-95 duration-150\">\n              <div className=\"flex items-center justify-between mb-3\">\n                <div className=\"flex items-center gap-1.5 font-heading font-bold text-sm text-slate-800\">\n                  <Sparkles className=\"w-4 h-4 text-pink-500\" />\n                  Add Gift Idea\n                </div>\n                <button\n                  onClick={() => setShowAddModal(false)}\n                  className=\"text-xs font-bold text-slate-400 hover:text-slate-600\"\n                >\n                  \342\234\225\n                </button>\n              </div>\n\n              <form onSubmit={handleCreateNewGift} className=\"space-y-3 text-xs\">\n                <div>\n                  <label className=\"block text-[11px] font-bold text-slate-700 mb-1\">\n                    Gift Title *\n                  </label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. Gabby\'s Purrfect Craft Box\"\n                    value={newItemTitle}\n                    onChange={(e) => setNewItemTitle(e.target.value)}\n                    className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                    required\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-[11px] font-bold text-slate-700 mb-1\">\n                    Category\n                  </label>\n                  <select\n                    value={newItemCategory}\n                    onChange={(e) => setNewItemCategory(e.target.value as GiftItem[\'category\'])}\n                    className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden bg-white\"\n                  >\n                    <option value=\"dollhouse\">\360\237\220\261 Gabby Dollhouse</option>\n                    <option value=\"crafts\">\360\237\216\250 Arts &amp; Crafts</option>\n                    <option value=\"dressup\">\360\237\221\227 Dress Up &amp; Costumes</option>\n                    <option value=\"books-stem\">\360\237\223\232 Books &amp; STEM</option>\n                    <option value=\"favorites\">\342\255\220 Other Favorites</option>\n                  </select>\n                </div>\n\n                <div>\n                  <label className=\"block text-[11px] font-bold text-slate-700 mb-1\">\n                    Estimated Price Range\n                  </label>\n                  <input\n                    type=\"text\"\n                    placeholder=\"e.g. $15 - $25\"\n                    value={newItemPrice}\n                    onChange={(e) => setNewItemPrice(e.target.value)}\n                    className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                  />\n                </div>\n\n                <div>\n                  <label className=\"block text-[11px] font-bold text-slate-700 mb-1\">\n                    Short Description (Optional)\n                  </label>\n                  <textarea\n                    rows={2}\n                    placeholder=\"Any details or link...\"\n                    value={newItemDesc}\n                    onChange={(e) => setNewItemDesc(e.target.value)}\n                    className=\"w-full p-2.5 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 focus:outline-hidden\"\n                  />\n                </div>\n\n                <div className=\"flex items-center gap-2 pt-2\">\n                  <button\n                    type=\"button\"\n                    onClick={() => setShowAddModal(false)}\n                    className=\"flex-1 py-2 font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl\"\n                  >\n                    Cancel\n                  </button>\n                  <button\n                    type=\"submit\"\n                    className=\"flex-1 py-2 font-bold text-white bg-gradient-to-r from-pink-500 to-purple-600 rounded-xl shadow\"\n                  >\n                    Save Gift Idea\n                  </button>\n                </div>\n              </form>\n            </div>\n          </div>\n        )}\n      </div>\n    </section>\n  );\n};\n"
    }
