              src={party.heroImageUrl}\n                  alt={party.celebrantName}\n                  className=\"w-full h-full object-cover\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              </div>\n            )}\n\n            {/* LAYER 4 (Top Canopy): Animated Gabby Cat Ears */}"
