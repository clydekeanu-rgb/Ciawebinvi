          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          filter.type = \'lowpass\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          filter.frequency.setValueAtTime(2200, now);"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          osc1.type = \'sawtooth\';"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
