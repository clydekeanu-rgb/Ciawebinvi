  file_change {
    absolute_path_uri: "file:///src/components/EditPartyModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { Settings, Image, Sparkles, MapPin, Calendar, Check, X } from \'lucide-react\';\nimport { PartyDetails } from \'../types\';\n\ninterface EditPartyModalProps {\n  party: PartyDetails;\n  isOpen: boolean;\n  onClose: () => void;\n  onSave: (updatedParty: PartyDetails) => void;\n}\n\nexport const EditPartyModal: React.FC<EditPartyModalProps> = ({\n  party,\n  isOpen,\n  onClose,\n  onSave\n}) => {\n  const [formData, setFormData] = useState<PartyDetails>(party);\n\n  if (!isOpen) return null;\n\n  const presetPhotos = [\n    { label: \'Photo 1 (Cute Party Girl)\', url: \'https://images.unsplash.com/photo-1516627145497-ae6968895b74?auto=format&fit=crop&w=800&q=80\' },\n    { label: \'Photo 2 (Sparkle Smile)\', url: \'https://images.unsplash.com/photo-1485546246426-74dc88dec4d9?auto=format&fit=crop&w=800&q=80\' },\n    { label: \'Photo 3 (Princess Dress)\', url: \'https://images.unsplash.com/photo-1502086223501-7ea6ecd79368?auto=format&fit=crop&w=800&q=80\' },\n    { label: \'Photo 4 (Party Hats)\', url: \'https://images.unsplash.com/photo-1530103862676-de8c9debad1d?auto=format&fit=crop&w=800&q=80\' },\n  ];\n\n  const handleSubmit = (e: React.FormEvent) => {\n    e.preventDefault();\n    onSave(formData);\n    onClose();\n  };\n\n  return (\n    <div className=\"fixed inset-0 z-50 bg-black/60 backdrop-blur-xs flex items-center justify-center p-4 overflow-y-auto\">\n      <div className=\"bg-white rounded-3xl p-5 max-w-md w-full shadow-2xl border-2 border-pink-300 my-8\">\n        {/* Header */}\n        <div className=\"flex items-center justify-between pb-3 border-b border-pink-100 mb-4\">\n          <div className=\"flex items-center gap-2\">\n            <div className=\"w-8 h-8 rounded-full bg-pink-100 flex items-center justify-center text-pink-600\">\n              <Settings className=\"w-4 h-4\" />\n            </div>\n            <div>\n              <h2 className=\"text-sm font-bold font-heading text-slate-800\">\n                Customize Party Invitation\n              </h2>\n              <p className=\"text-[11px] text-slate-500\">Edit celebrant name, photo, date &amp; venue</p>\n            </div>\n          </div>\n\n          <button\n            onClick={onClose}\n            className=\"w-7 h-7 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-500 font-bold text-xs\"\n          >\n            <X className=\"w-4 h-4\" />\n          </button>\n        </div>\n\n        <form onSubmit={handleSubmit} className=\"space-y-3.5 text-xs\">\n          {/* Celebrant Info */}\n          <div className=\"grid grid-cols-3 gap-2\">\n            <div className=\"col-span-2\">\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Celebrant Name *\n              </label>\n              <input\n                type=\"text\"\n                value={formData.celebrantName}\n                onChange={(e) => setFormData({ ...formData, celebrantName: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n                required\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Age Turning *\n              </label>\n              <input\n                type=\"number\"\n                min=\"1\"\n                max=\"18\"\n                value={formData.celebrantAge}\n                onChange={(e) => setFormData({ ...formData, celebrantAge: parseInt(e.target.value) || 5 })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 text-center font-bold\"\n                required\n              />\n            </div>\n          </div>\n\n          {/* Subtitle / Theme */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n              Event Subtitle / Tagline\n            </label>\n            <input\n              type=\"text\"\n              value={formData.subtitle}\n              onChange={(e) => setFormData({ ...formData, subtitle: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          {/* Celebrant Hero Photo */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1 flex items-center gap-1\">\n              <Image className=\"w-3.5 h-3.5 text-pink-500\" />\n              Celebrant Photo Image URL\n            </label>\n            <input\n              type=\"url\"\n              value={formData.heroImageUrl}\n              onChange={(e) => setFormData({ ...formData, heroImageUrl: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400 text-[11px]\"\n              placeholder=\"https://...\"\n            />\n\n            {/* Quick Photo Presets */}\n            <div className=\"mt-1.5 flex items-center gap-1.5 overflow-x-auto pb-1\">\n              {presetPhotos.map((p, idx) => (\n                <button\n                  key={idx}\n                  type=\"button\"\n                  onClick={() => setFormData({ ...formData, heroImageUrl: p.url })}\n                  className=\"w-8 h-8 rounded-lg overflow-hidden border-2 border-pink-200 hover:border-pink-500 shrink-0\"\n                  title={p.label}\n                >\n                  <img src={p.url} alt=\"\" className=\"w-full h-full object-cover\" referrerPolicy=\"no-referrer\" />\n                </button>\n              ))}\n            </div>\n          </div>\n\n          {/* Date & Time */}\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Date Display Text\n              </label>\n              <input\n                type=\"text\"\n                value={formData.dateDisplay}\n                onChange={(e) => setFormData({ ...formData, dateDisplay: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Time Display\n              </label>\n              <input\n                type=\"text\"\n                value={formData.timeDisplay}\n                onChange={(e) => setFormData({ ...formData, timeDisplay: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n          </div>\n\n          {/* Venue Details */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1 flex items-center gap-1\">\n              <MapPin className=\"w-3.5 h-3.5 text-purple-500\" />\n              Venue Name\n            </label>\n            <input\n              type=\"text\"\n              value={formData.venueName}\n              onChange={(e) => setFormData({ ...formData, venueName: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          <div className=\"grid grid-cols-2 gap-2\">\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                Address\n              </label>\n              <input\n                type=\"text\"\n                value={formData.venueAddress}\n                onChange={(e) => setFormData({ ...formData, venueAddress: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n            <div>\n              <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n                City, State, Zip\n              </label>\n              <input\n                type=\"text\"\n                value={formData.venueCityState}\n                onChange={(e) => setFormData({ ...formData, venueCityState: e.target.value })}\n                className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n              />\n            </div>\n          </div>\n\n          {/* Contact phone */}\n          <div>\n            <label className=\"block text-[10px] font-bold text-slate-700 mb-1\">\n              Host Contact Phone\n            </label>\n            <input\n              type=\"text\"\n              value={formData.contactPhone}\n              onChange={(e) => setFormData({ ...formData, contactPhone: e.target.value })}\n              className=\"w-full p-2 rounded-xl border border-slate-200 focus:ring-2 focus:ring-pink-400\"\n            />\n          </div>\n\n          {/* Buttons */}\n          <div className=\"flex items-center gap-2 pt-3 border-t border-slate-100\">\n            <button\n              type=\"button\"\n              onClick={onClose}\n              className=\"flex-1 py-2.5 font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-xl\"\n            >\n              Cancel\n            </button>\n            <button\n              type=\"submit\"\n              className=\"flex-1 py-2.5 font-bold text-white bg-gradient-to-r from-pink-500 via-purple-500 to-teal-500 hover:from-pink-600 hover:to-teal-600 rounded-xl shadow flex items-center justify-center gap-1.5\"\n            >\n              <Check className=\"w-4 h-4\" />\n              Save Changes\n            </button>\n          </div>\n        </form>\n      </div>\n    </div>\n  );\n};\n"
    }
