    replacement_chunks {
      target_content: "import React from \'react\';\nimport { Sparkles, Calendar, Heart, Wand2, PartyPopper, MapPin } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { PartyDetails } from \'../types\';\nimport { audioEngine } from \'../utils/audioSynth\';\n\ninterface HeroSectionProps {\n  party: PartyDetails;\n  onRsvpClick: () => void;\n  onDirectionsClick: () => void;\n  onEditClick: () => void;\n}\n\nexport const HeroSection: React.FC<HeroSectionProps> = ({\n  party,\n  onRsvpClick,\n  onDirectionsClick,\n  onEditClick\n}) => {\n  const triggerPinchMagic = () => {\n    audioEngine.playSparkleSound();\n    confetti({\n      particleCount: 80,\n      spread: 70,\n      origin: { y: 0.35 },\n      colors: [\'#FF69B4\', \'#38BDF8\', \'#C084FC\', \'#FBBF24\', \'#F472B6\']\n    });\n  };\n\n  const handleAddToCalendar = () => {\n    const title = encodeURIComponent(party.eventTitle);\n    const details = encodeURIComponent(\n      `${party.subtitle}\\nDress code: ${party.dressCode}\\nContact: ${party.contactName} (${party.contactPhone})`\n    );\n    const location = encodeURIComponent(`${party.venueName}, ${party.venueAddress}, ${party.venueCityState}`);\n    \n    // 2:00 PM to 5:30 PM on the event date (2026-09-19)\n    const startDate = \'20260919T140000\';\n    const endDate = \'20260919T173000\';\n    const googleCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${startDate}/${endDate}&details=${details}&location=${location}`;\n    \n    window.open(googleCalUrl, \'_blank\');\n  };\n\n  return (\n    <section id=\"hero-celebrant-section\" className=\"relative pt-6 pb-10 px-4 overflow-hidden\">\n      {/* Background Decorative Gradient & Sprinkles */}\n      <div className=\"absolute inset-0 bg-gradient-to-b from-pink-100/70 via-purple-50/50 to-transparent pointer-events-none\" />\n\n      {/* Floating Sprinkles */}\n      <div className=\"absolute top-4 left-6 text-pink-300 animate-float opacity-70\">\n        <Sparkles className=\"w-6 h-6\" />\n      </div>\n      <div className=\"absolute top-12 right-6 text-teal-300 animate-float-reverse opacity-70\">\n        <Sparkles className=\"w-7 h-7\" />\n      </div>\n\n      <div className=\"max-w-md mx-auto relative z-10 flex flex-col items-center text-center\">\n        {/* Gabby Cat Ears & Celebrant Photo Frame */}\n        <div className=\"relative mb-5 mt-2\">\n          {/* Animated Kitty Ears Top Frame */}\n          <div className=\"absolute -top-7 inset-x-0 flex justify-between px-6 z-20 pointer-events-none\">\n            {/* Left Cat Ear with Bow */}\n            <div className=\"relative w-12 h-12 bg-gradient-to-tr from-pink-500 to-rose-400 rounded-tl-3xl rounded-tr-lg border-2 border-white shadow-md transform -rotate-12 flex items-center justify-center\">\n              <div className=\"w-6 h-6 bg-pink-200 rounded-tl-2xl rounded-tr-md\" />\n              {/* Cute little yellow bow */}\n              <div className=\"absolute -bottom-1 -right-1 text-xs\">\360\237\216\200</div>\n            </div>\n\n            {/* Right Cat Ear */}\n            <div className=\"w-12 h-12 bg-gradient-to-tl from-purple-500 to-pink-400 rounded-tr-3xl rounded-tl-lg border-2 border-white shadow-md transform rotate-12 flex items-center justify-center\">\n              <div className=\"w-6 h-6 bg-purple-200 rounded-tr-2xl rounded-tl-md\" />\n            </div>\n          </div>\n\n          {/* Celebrant Main Hero Photo */}\n          <div className=\"relative w-44 h-44 sm:w-48 sm:h-48 rounded-full p-1.5 bg-gradient-to-tr from-pink-400 via-purple-400 to-teal-400 shadow-2xl animate-glow\">\n            <div className=\"w-full h-full rounded-full overflow-hidden border-4 border-white bg-pink-50 relative group\">\n              <img\n                src={party.heroImageUrl}\n                alt={party.celebrantName}\n                className=\"w-full h-full object-cover group-hover:scale-105 transition-transform duration-500\"\n                referrerPolicy=\"no-referrer\"\n              />\n              \n              {/* Quick Host Edit Photo overlay button */}\n              <button\n                onClick={onEditClick}\n                className=\"absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center text-white text-xs font-bold gap-1\"\n                title=\"Edit Celebrant Photo / Details\"\n              >\n                \342\234\217\357\270\217 Change Details\n              </button>\n            </div>\n\n            {/* Age Badge Pill */}\n            <div className=\"absolute -bottom-2 inset-x-0 flex justify-center\">\n              <div className=\"bg-gradient-to-r from-pink-500 via-purple-500 to-pink-500 text-white font-extrabold text-xs sm:text-sm px-4 py-1 rounded-full shadow-lg border-2 border-white flex items-center gap-1.5 animate-bounce\">\n                <PartyPopper className=\"w-3.5 h-3.5 text-yellow-300\" />\n                <span>Turning {party.celebrantAge}!</span>\n                <Sparkles className=\"w-3.5 h-3.5 text-yellow-300 fill-yellow-300\" />\n              </div>\n            </div>\n          </div>\n        </div>\n\n        {/* Celebrant Title & Header */}\n        <div className=\"mt-2 space-y-1.5\">\n          <div className=\"inline-flex items-center gap-1 px-3 py-1 rounded-full bg-pink-100/90 text-pink-700 text-xs font-bold tracking-wide\">\n            <Heart className=\"w-3 h-3 fill-pink-500 text-pink-500\" />\n            Gabby&apos;s Dollhouse Birthday Party\n          </div>\n\n          <h1 className=\"text-3xl sm:text-4xl font-extrabold font-heading text-slate-800 tracking-tight leading-tight\">\n            {party.celebrantName}&apos;s 5th Birthday!\n          </h1>\n\n          <p className=\"text-sm font-medium text-slate-600 max-w-xs mx-auto leading-relaxed\">\n            {party.subtitle}\n          </p>\n        </div>\n\n        {/* Gabby Magic Quote Box */}\n        <div className=\"mt-4 p-3 rounded-2xl bg-white/90 border border-pink-200/80 shadow-sm max-w-sm w-full relative\">\n          <p className=\"text-xs text-slate-700 font-medium italic\">\n            {party.celebrantBirthdayQuote}\n          </p>\n          <button\n            onClick={triggerPinchMagic}\n            className=\"mt-2 text-[11px] font-bold text-pink-600 hover:text-pink-700 inline-flex items-center gap-1 bg-pink-50 hover:bg-pink-100 px-2.5 py-1 rounded-full border border-pink-200 transition-colors cursor-pointer\"\n          >\n            <Wand2 className=\"w-3 h-3 text-pink-500\" />\n            Pinch for Dollhouse Magic! \342\234\250\n          </button>\n        </div>\n\n        {/* Date & Time Highlight Card */}\n        <div className=\"mt-4 w-full max-w-sm bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 p-0.5 rounded-2xl shadow-md\">\n          <div className=\"bg-white rounded-[14px] p-3.5 flex items-center justify-between\">\n            <div className=\"flex items-center gap-3 text-left\">\n              <div className=\"w-10 h-10 rounded-xl bg-pink-100 flex items-center justify-center text-pink-600 shrink-0\">\n                <Calendar className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <p className=\"text-xs font-bold text-slate-900\">{party.dateDisplay}</p>\n                <p className=\"text-xs text-pink-600 font-medium\">{party.timeDisplay}</p>\n              </div>\n            </div>\n            <button\n              onClick={handleAddToCalendar}\n              className=\"text-xs font-bold text-purple-700 hover:text-purple-900 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-xl border border-purple-200 transition-colors shrink-0\"\n              title=\"Add to Google Calendar\"\n            >\n              + Cal\n            </button>\n          </div>\n        </div>\n\n        {/* Quick CTA Action Row */}\n        <div className=\"mt-5 grid grid-cols-2 gap-2.5 w-full max-w-sm\">\n          <button\n            id=\"hero-rsvp-btn\"\n            onClick={onRsvpClick}\n            className=\"py-3 px-4 rounded-xl bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-bold text-sm shadow-lg shadow-pink-300/50 flex items-center justify-center gap-1.5 transition-all transform active:scale-95 cursor-pointer\"\n          >\n            <PartyPopper className=\"w-4 h-4\" />\n            RSVP Attending\n          </button>\n\n          <button\n            id=\"hero-directions-btn\"\n            onClick={onDirectionsClick}\n            className=\"py-3 px-4 rounded-xl bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 text-white font-bold text-sm shadow-lg shadow-purple-300/50 flex items-center justify-center gap-1.5 transition-all transform active:scale-95 cursor-pointer\"\n          >\n            <MapPin className=\"w-4 h-4\" />\n            Location & Map\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n};"
      replacement_content: "import React, { useState, useEffect, useRef } from \'react\';\nimport { Sparkles, Calendar, Heart, Wand2, PartyPopper, MapPin, Layers, Upload } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { PartyDetails } from \'../types\';\nimport { audioEngine } from \'../utils/audioSynth\';\n\ninterface HeroSectionProps {\n  party: PartyDetails;\n  onRsvpClick: () => void;\n  onDirectionsClick: () => void;\n  onEditClick: () => void;\n}\n\nexport const HeroSection: React.FC<HeroSectionProps> = ({\n  party,\n  onRsvpClick,\n  onDirectionsClick,\n  onEditClick\n}) => {\n  const [tilt, setTilt] = useState({ x: 0, y: 0 });\n  const [isHovered, setIsHovered] = useState(false);\n  const [scrollY, setScrollY] = useState(0);\n  const containerRef = useRef<HTMLDivElement>(null);\n\n  // Track scroll position for scroll-based parallax\n  useEffect(() => {\n    const handleScroll = () => {\n      setScrollY(window.scrollY);\n    };\n    window.addEventListener(\'scroll\', handleScroll, { passive: true });\n    return () => window.removeEventListener(\'scroll\', handleScroll);\n  }, []);\n\n  // Handle pointer / mouse movement for 3D tilt\n  const handlePointerMove = (e: React.PointerEvent<HTMLDivElement>) => {\n    if (!containerRef.current) return;\n    const rect = containerRef.current.getBoundingClientRect();\n    const x = e.clientX - rect.left;\n    const y = e.clientY - rect.top;\n\n    const centerX = rect.width / 2;\n    const centerY = rect.height / 2;\n\n    // Calculate tilt range (-15 to 15 degrees)\n    const rotateX = ((y - centerY) / centerY) * -14;\n    const rotateY = ((x - centerX) / centerX) * 14;\n\n    setTilt({ x: rotateX, y: rotateY });\n  };\n\n  const handlePointerLeave = () => {\n    setIsHovered(false);\n    setTilt({ x: 0, y: 0 });\n  };\n\n  const handlePointerEnter = () => {\n    setIsHovered(true);\n  };\n\n  const triggerPinchMagic = () => {\n    audioEngine.playSparkleSound();\n    confetti({\n      particleCount: 80,\n      spread: 70,\n      origin: { y: 0.35 },\n      colors: [\'#FF69B4\', \'#38BDF8\', \'#C084FC\', \'#FBBF24\', \'#F472B6\']\n    });\n  };\n\n  const handleAddToCalendar = () => {\n    const title = encodeURIComponent(party.eventTitle);\n    const details = encodeURIComponent(\n      `${party.subtitle}\\nDress code: ${party.dressCode}\\nContact: ${party.contactName} (${party.contactPhone})`\n    );\n    const location = encodeURIComponent(`${party.venueName}, ${party.venueAddress}, ${party.venueCityState}`);\n    \n    const startDate = \'20260919T140000\';\n    const endDate = \'20260919T173000\';\n    const googleCalUrl = `https://calendar.google.com/calendar/render?action=TEMPLATE&text=${title}&dates=${startDate}/${endDate}&details=${details}&location=${location}`;\n    \n    window.open(googleCalUrl, \'_blank\');\n  };\n\n  // Compute layered parallax transforms\n  const scrollOffsetBg = Math.min(scrollY * 0.15, 30);\n  const scrollOffsetFg = Math.min(scrollY * -0.2, 40);\n\n  const bgTransform = isHovered\n    ? `translate3d(${tilt.y * -0.6}px, ${tilt.x * 0.6 + scrollOffsetBg}px, -20px) scale(1.12)`\n    : `translate3d(0px, ${scrollOffsetBg}px, -20px) scale(1.08)`;\n\n  const fgTransform = isHovered\n    ? `translate3d(${tilt.y * 1.3}px, ${tilt.x * -1.3 + scrollOffsetFg}px, 45px) scale(1.04)`\n    : `translate3d(0px, ${scrollOffsetFg}px, 30px) scale(1)`;\n\n  const badgeTransform = isHovered\n    ? `translate3d(${tilt.y * 1.8}px, ${tilt.x * -1.8}px, 60px)`\n    : \'translate3d(0px, 0px, 40px)\';\n\n  return (\n    <section id=\"hero-celebrant-section\" className=\"relative pt-6 pb-10 px-4 overflow-hidden\">\n      {/* Background Decorative Gradient & Sprinkles */}\n      <div className=\"absolute inset-0 bg-gradient-to-b from-pink-100/70 via-purple-50/50 to-transparent pointer-events-none\" />\n\n      {/* Floating Sprinkles */}\n      <div className=\"absolute top-4 left-6 text-pink-300 animate-float opacity-70\">\n        <Sparkles className=\"w-6 h-6\" />\n      </div>\n      <div className=\"absolute top-12 right-6 text-teal-300 animate-float-reverse opacity-70\">\n        <Sparkles className=\"w-7 h-7\" />\n      </div>\n\n      <div className=\"max-w-md mx-auto relative z-10 flex flex-col items-center text-center\">\n        {/* Parallax Tag Badge */}\n        <div className=\"mb-3 inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-white/90 text-pink-700 text-xs font-bold tracking-wide shadow-sm border border-pink-200 backdrop-blur-xs\">\n          <Layers className=\"w-3.5 h-3.5 text-purple-600\" />\n          <span>Interactive 2.5D Parallax Stage</span>\n        </div>\n\n        {/* 2-Image Parallax Hero Stage */}\n        <div\n          ref={containerRef}\n          onPointerMove={handlePointerMove}\n          onPointerEnter={handlePointerEnter}\n          onPointerLeave={handlePointerLeave}\n          className=\"relative w-72 sm:w-80 h-72 sm:h-80 my-2 rounded-3xl cursor-grab active:cursor-grabbing select-none [perspective:1000px] group\"\n          title=\"Move your mouse or drag to tilt the 2.5D parallax photo!\"\n        >\n          {/* Main 3D Card Base with preserve-3d */}\n          <div\n            className=\"relative w-full h-full rounded-3xl transition-transform duration-300 ease-out shadow-2xl border-4 border-white/90 overflow-visible\"\n            style={{\n              transformStyle: \'preserve-3d\',\n              transform: `rotateX(${tilt.x}deg) rotateY(${tilt.y}deg)`,\n              background: \'linear-gradient(135deg, #fbcfe8 0%, #e9d5ff 50%, #bae6fd 100%)\'\n            }}\n          >\n            {/* LAYER 1 (Deep Background): Full / Whole Scene Image */}\n            <div\n              className=\"absolute inset-0 rounded-[22px] overflow-hidden transition-transform duration-300 ease-out\"\n              style={{\n                transform: bgTransform,\n                transformStyle: \'preserve-3d\',\n              }}\n            >\n              <img\n                src={party.heroImageUrl}\n                alt={`${party.celebrantName} background scene`}\n                className=\"w-full h-full object-cover filter brightness-95 saturate-110\"\n                referrerPolicy=\"no-referrer\"\n              />\n              {/* Soft atmospheric gradient overlay */}\n              <div className=\"absolute inset-0 bg-gradient-to-t from-purple-900/40 via-transparent to-pink-500/20\" />\n            </div>\n\n            {/* LAYER 2 (Middle Depth): Floating Sparkles & Soft Light Rays */}\n            <div\n              className=\"absolute inset-0 pointer-events-none transition-transform duration-300 ease-out overflow-hidden\"\n              style={{\n                transform: `translate3d(${tilt.y * 0.4}px, ${tilt.x * -0.4}px, 15px)`\n              }}\n            >\n              <div className=\"absolute top-3 left-4 text-yellow-200 animate-pulse text-xl\">\342\234\250</div>\n              <div className=\"absolute bottom-10 right-4 text-pink-200 animate-pulse text-lg\">\360\237\222\226</div>\n              <div className=\"absolute top-8 right-6 text-cyan-200 animate-bounce text-sm\">\342\255\220</div>\n            </div>\n\n            {/* LAYER 3 (Foreground Cutout): Subject with No Background */}\n            {party.heroCutoutImageUrl ? (\n              <div\n                className=\"absolute inset-0 flex items-end justify-center pointer-events-none transition-transform duration-300 ease-out z-20\"\n                style={{\n                  transform: fgTransform,\n                  transformStyle: \'preserve-3d\',\n                }}\n              >\n                <img\n                  src={party.heroCutoutImageUrl}\n                  alt={`${party.celebrantName} cutout`}\n                  className=\"w-full h-[96%] object-contain drop-shadow-[0_20px_25px_rgba(0,0,0,0.45)] filter contrast-105\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              </div>\n            ) : (\n              /* If only 1 image provided, showcase subject with 3D elevation */\n              <div\n                className=\"absolute inset-x-6 bottom-4 top-10 rounded-2xl overflow-hidden shadow-2xl border-2 border-white pointer-events-none transition-transform duration-300 ease-out z-20\"\n                style={{\n                  transform: fgTransform,\n                }}\n              >\n                <img\n                  src={party.heroImageUrl}\n                  alt={party.celebrantName}\n                  className=\"w-full h-full object-cover\"\n                  referrerPolicy=\"no-referrer\"\n                />\n              </div>\n            )}\n\n            {/* LAYER 4 (Top Canopy): Animated Gabby Cat Ears */}\n            <div\n              className=\"absolute -top-7 inset-x-0 flex justify-between px-6 z-30 pointer-events-none transition-transform duration-300 ease-out\"\n              style={{\n                transform: `translate3d(${tilt.y * 1.5}px, ${tilt.x * -1.5}px, 50px)`\n              }}\n            >\n              {/* Left Cat Ear with Bow */}\n              <div className=\"relative w-12 h-12 bg-gradient-to-tr from-pink-500 to-rose-400 rounded-tl-3xl rounded-tr-lg border-2 border-white shadow-xl transform -rotate-12 flex items-center justify-center\">\n                <div className=\"w-6 h-6 bg-pink-200 rounded-tl-2xl rounded-tr-md\" />\n                <div className=\"absolute -bottom-1 -right-1 text-xs\">\360\237\216\200</div>\n              </div>\n\n              {/* Right Cat Ear */}\n              <div className=\"w-12 h-12 bg-gradient-to-tl from-purple-500 to-pink-400 rounded-tr-3xl rounded-tl-lg border-2 border-white shadow-xl transform rotate-12 flex items-center justify-center\">\n                <div className=\"w-6 h-6 bg-purple-200 rounded-tr-2xl rounded-tl-md\" />\n              </div>\n            </div>\n\n            {/* LAYER 5 (Floating Badge): \"Turning 5!\" Age Pill */}\n            <div\n              className=\"absolute -bottom-4 inset-x-0 flex justify-center z-40 transition-transform duration-300 ease-out pointer-events-none\"\n              style={{\n                transform: badgeTransform\n              }}\n            >\n              <div className=\"bg-gradient-to-r from-pink-500 via-purple-500 to-pink-500 text-white font-extrabold text-xs sm:text-sm px-4 py-1.5 rounded-full shadow-2xl border-2 border-white flex items-center gap-1.5 animate-bounce\">\n                <PartyPopper className=\"w-3.5 h-3.5 text-yellow-300\" />\n                <span>Turning {party.celebrantAge}!</span>\n                <Sparkles className=\"w-3.5 h-3.5 text-yellow-300 fill-yellow-300\" />\n              </div>\n            </div>\n\n            {/* Quick Edit Overlay Button */}\n            <button\n              onClick={onEditClick}\n              className=\"absolute top-3 right-3 z-50 bg-black/60 hover:bg-black/80 text-white text-[11px] font-bold px-2.5 py-1 rounded-xl backdrop-blur-xs flex items-center gap-1 shadow-lg opacity-80 group-hover:opacity-100 transition-opacity cursor-pointer\"\n              title=\"Replace Whole Image & Cutout Image\"\n            >\n              <Upload className=\"w-3 h-3 text-pink-300\" />\n              <span>Change 2 Images</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Parallax Guidance Hint */}\n        <p className=\"text-[11px] text-slate-500 font-medium mt-3 flex items-center gap-1\">\n          <span>\342\234\250 Move cursor or drag on photo to experience 3D depth!</span>\n        </p>\n\n        {/* Celebrant Title & Header */}\n        <div className=\"mt-4 space-y-1.5\">\n          <div className=\"inline-flex items-center gap-1 px-3 py-1 rounded-full bg-pink-100/90 text-pink-700 text-xs font-bold tracking-wide\">\n            <Heart className=\"w-3 h-3 fill-pink-500 text-pink-500\" />\n            Gabby&apos;s Dollhouse Birthday Party\n          </div>\n\n          <h1 className=\"text-3xl sm:text-4xl font-extrabold font-heading text-slate-800 tracking-tight leading-tight\">\n            {party.celebrantName}&apos;s 5th Birthday!\n          </h1>\n\n          <p className=\"text-sm font-medium text-slate-600 max-w-xs mx-auto leading-relaxed\">\n            {party.subtitle}\n          </p>\n        </div>\n\n        {/* Gabby Magic Quote Box */}\n        <div className=\"mt-4 p-3 rounded-2xl bg-white/90 border border-pink-200/80 shadow-sm max-w-sm w-full relative\">\n          <p className=\"text-xs text-slate-700 font-medium italic\">\n            {party.celebrantBirthdayQuote}\n          </p>\n          <button\n            onClick={triggerPinchMagic}\n            className=\"mt-2 text-[11px] font-bold text-pink-600 hover:text-pink-700 inline-flex items-center gap-1 bg-pink-50 hover:bg-pink-100 px-2.5 py-1 rounded-full border border-pink-200 transition-colors cursor-pointer\"\n          >\n            <Wand2 className=\"w-3 h-3 text-pink-500\" />\n            Pinch for Dollhouse Magic! \342\234\250\n          </button>\n        </div>\n\n        {/* Date & Time Highlight Card */}\n        <div className=\"mt-4 w-full max-w-sm bg-gradient-to-r from-pink-500 via-purple-500 to-indigo-500 p-0.5 rounded-2xl shadow-md\">\n          <div className=\"bg-white rounded-[14px] p-3.5 flex items-center justify-between\">\n            <div className=\"flex items-center gap-3 text-left\">\n              <div className=\"w-10 h-10 rounded-xl bg-pink-100 flex items-center justify-center text-pink-600 shrink-0\">\n                <Calendar className=\"w-5 h-5\" />\n              </div>\n              <div>\n                <p className=\"text-xs font-bold text-slate-900\">{party.dateDisplay}</p>\n                <p className=\"text-xs text-pink-600 font-medium\">{party.timeDisplay}</p>\n              </div>\n            </div>\n            <button\n              onClick={handleAddToCalendar}\n              className=\"text-xs font-bold text-purple-700 hover:text-purple-900 bg-purple-50 hover:bg-purple-100 px-3 py-1.5 rounded-xl border border-purple-200 transition-colors shrink-0 cursor-pointer\"\n              title=\"Add to Google Calendar\"\n            >\n              + Cal\n            </button>\n          </div>\n        </div>\n\n        {/* Quick CTA Action Row */}\n        <div className=\"mt-5 grid grid-cols-2 gap-2.5 w-full max-w-sm\">\n          <button\n            id=\"hero-rsvp-btn\"\n            onClick={onRsvpClick}\n            className=\"py-3 px-4 rounded-xl bg-gradient-to-r from-pink-500 to-rose-500 hover:from-pink-600 hover:to-rose-600 text-white font-bold text-sm shadow-lg shadow-pink-300/50 flex items-center justify-center gap-1.5 transition-all transform active:scale-95 cursor-pointer\"\n          >\n            <PartyPopper className=\"w-4 h-4\" />\n            RSVP Attending\n          </button>\n\n          <button\n            id=\"hero-directions-btn\"\n            onClick={onDirectionsClick}\n            className=\"py-3 px-4 rounded-xl bg-gradient-to-r from-purple-500 to-indigo-500 hover:from-purple-600 hover:to-indigo-600 text-white font-bold text-sm shadow-lg shadow-purple-300/50 flex items-center justify-center gap-1.5 transition-all transform active:scale-95 cursor-pointer\"\n          >\n            <MapPin className=\"w-4 h-4\" />\n            Location & Map\n          </button>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
