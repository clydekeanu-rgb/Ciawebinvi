      replacement_content: "import React from \'react\';\nimport { Sparkles, Phone, ShieldAlert, HeartHandshake } from \'lucide-react\';\nimport { PartyDetails } from \'../types\';\n\ninterface PartyDetailsCardProps {\n  party: PartyDetails;\n}\n\nexport const PartyDetailsCard: React.FC<PartyDetailsCardProps> = ({ party }) => {\n  return (\n    <section id=\"party-details-section\" className=\"px-4 py-6 max-w-md mx-auto\">\n      <div className=\"bg-white rounded-3xl p-5 shadow-xl border-2 border-amber-200 relative overflow-hidden\">\n        {/* Header */}\n        <div className=\"flex items-center gap-2 mb-4\">\n          <div className=\"w-8 h-8 rounded-full bg-amber-100 flex items-center justify-center text-amber-600\">\n            <Sparkles className=\"w-4 h-4\" />\n          </div>\n          <div>\n            <h2 className=\"text-sm font-bold font-heading text-slate-800 uppercase tracking-wider\">\n              Party Theme &amp; Guest Info\n            </h2>\n            <p className=\"text-[11px] text-slate-500 font-medium\">What to wear &amp; what to expect</p>\n          </div>\n        </div>\n\n        <div className=\"space-y-3\">\n          {/* Dress Code Card */}\n          <div className=\"bg-gradient-to-r from-pink-50 via-rose-50 to-purple-50 rounded-2xl p-3.5 border border-pink-200\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-pink-900 mb-1\">\n              <span>\360\237\216\200</span>\n              <span>Dress Code &amp; Costumes</span>\n            </div>\n            <p className=\"text-xs text-slate-700 font-medium leading-relaxed\">\n              {party.dressCode}\n            </p>\n            <p className=\"text-[11px] text-slate-500 mt-1\">\n              Cat ears will also be provided at the welcome station for all little guests!\n            </p>\n          </div>\n\n          {/* Refreshments & Treats */}\n          <div className=\"bg-gradient-to-r from-amber-50 to-yellow-50 rounded-2xl p-3.5 border border-amber-200\">\n            <div className=\"flex items-center gap-1.5 text-xs font-bold text-amber-900 mb-1\">\n              <span>\360\237\247\201</span>\n              <span>Food, Cakes &amp; Treats</span>\n            </div>\n            <p className=\"text-xs text-slate-700 font-medium leading-relaxed\">\n              Fresh artisan pizza, rainbow fruit skewers, Cakey Cat sprinkle cupcakes, and Mercat sparkle punch!\n            </p>\n            <p className=\"text-[11px] text-slate-500 mt-1\">\n              Nut-free, dairy-free, and gluten-free snack options will be clearly labeled.\n            </p>\n          </div>\n\n          {/* Host Contact & Questions */}\n          <div className=\"bg-slate-50 rounded-2xl p-3.5 border border-slate-200 flex items-center justify-between\">\n            <div className=\"flex items-center gap-2.5\">\n              <div className=\"w-8 h-8 rounded-full bg-purple-100 flex items-center justify-center text-purple-600\">\n                <Phone className=\"w-4 h-4\" />\n              </div>\n              <div>\n                <p className=\"text-xs font-bold text-slate-800\">Questions? Contact Host</p>\n                <p className=\"text-[11px] text-slate-500\">{party.contactName}</p>\n              </div>\n            </div>\n\n            <a\n              href={`tel:${party.contactPhone.replace(/\\D/g, \'\')}`}\n              className=\"text-xs font-bold text-purple-700 bg-purple-100 hover:bg-purple-200 px-3 py-1.5 rounded-xl transition-colors shrink-0\"\n            >\n              {party.contactPhone}\n            </a>\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n};\n"
    }
