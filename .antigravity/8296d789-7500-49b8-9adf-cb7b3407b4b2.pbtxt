    file_change_type: FILE_CHANGE_TYPE_EDIT
    replacement_chunks {
      target_content: "import React, { useState, useEffect } from \'react\';\nimport { Sparkles, Heart, Gift, MapPin, Clock, Calendar, Mail, Settings, Share2, Music, Check, Volume2, RefreshCw } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { InteractiveEnvelope } from \'./components/InteractiveEnvelope\';\nimport { HeroSection } from \'./components/HeroSection\';\nimport { CountdownTimer } from \'./components/CountdownTimer\';\nimport { VenueMapSection } from \'./components/VenueMapSection\';\nimport { GiftRegistrySection } from \'./components/GiftRegistrySection\';\nimport { PartyTimeline } from \'./components/PartyTimeline\';\nimport { PartyDetailsCard } from \'./components/PartyDetailsCard\';\nimport { RsvpSection } from \'./components/RsvpSection\';\nimport { WishesWall } from \'./components/WishesWall\';\nimport { MusicPlayer } from \'./components/MusicPlayer\';\nimport { EditPartyModal } from \'./components/EditPartyModal\';\nimport { initialPartyDetails, initialGiftRegistry, partyTimeline, initialBirthdayWishes } from \'./data/partyData\';\nimport { PartyDetails, GiftItem, RsvpSubmission, BirthdayWish } from \'./types\';\nimport { audioEngine } from \'./utils/audioSynth\';\n\nexport default function App() {\n  const [isOpened, setIsOpened] = useState(false);\n  const [party, setParty] = useState<PartyDetails>(() => {\n    const saved = localStorage.getItem(\'gabby_party_details\');\n    return saved ? JSON.parse(saved) : initialPartyDetails;\n  });\n\n  const [gifts, setGifts] = useState<GiftItem[]>(() => {\n    const saved = localStorage.getItem(\'gabby_gift_registry\');\n    return saved ? JSON.parse(saved) : initialGiftRegistry;\n  });\n\n  const [rsvps, setRsvps] = useState<RsvpSubmission[]>(() => {\n    const saved = localStorage.getItem(\'gabby_party_rsvps\');\n    if (saved) return JSON.parse(saved);\n    return [\n      {\n        id: \'rsvp-1\',\n        guestName: \'The Miller Family\',\n        emailOrPhone: \'miller@example.com\',\n        attending: \'yes\',\n        adultsCount: 2,\n        kidsCount: 2,\n        kidsNames: \'Lily (5) & Toby (3)\',\n        dietaryRestrictions: \'None\',\n        birthdayWish: \'So excited to celebrate Mia!\',\n        submittedAt: \'Yesterday\'\n      },\n      {\n        id: \'rsvp-2\',\n        guestName: \'Auntie Chloe & Ben\',\n        emailOrPhone: \'555-443-2211\',\n        attending: \'yes\',\n        adultsCount: 2,\n        kidsCount: 0,\n        dietaryRestrictions: \'Vegetarian\',\n        birthdayWish: \'Happy birthday sweet Mia!\',\n        submittedAt: \'2 days ago\'\n      }\n    ];\n  });\n\n  const [wishes, setWishes] = useState<BirthdayWish[]>(() => {\n    const saved = localStorage.getItem(\'gabby_party_wishes\');\n    return saved ? JSON.parse(saved) : initialBirthdayWishes;\n  });\n\n  const [isEditModalOpen, setIsEditModalOpen] = useState(false);\n  const [copiedLink, setCopiedLink] = useState(false);\n\n  // Save to localStorage when updated\n  useEffect(() => {\n    localStorage.setItem(\'gabby_party_details\', JSON.stringify(party));\n  }, [party]);\n\n  useEffect(() => {\n    localStorage.setItem(\'gabby_gift_registry\', JSON.stringify(gifts));\n  }, [gifts]);\n\n  useEffect(() => {\n    localStorage.setItem(\'gabby_party_rsvps\', JSON.stringify(rsvps));\n  }, [rsvps]);\n\n  useEffect(() => {\n    localStorage.setItem(\'gabby_party_wishes\', JSON.stringify(wishes));\n  }, [wishes]);\n\n  const handleOpenEnvelope = () => {\n    setIsOpened(true);\n  };\n\n  const handleReplayEnvelope = () => {\n    setIsOpened(false);\n  };\n\n  const handleToggleClaimGift = (giftId: string, claimedBy?: string) => {\n    setGifts(prev =>\n      prev.map(item => {\n        if (item.id === giftId) {\n          if (item.isClaimed) {\n            return { ...item, isClaimed: false, claimedByName: undefined, claimedAt: undefined };\n          } else {\n            return {\n              ...item,\n              isClaimed: true,\n              claimedByName: claimedBy || \'Guest\',\n              claimedAt: \'Just now\'\n            };\n          }\n        }\n        return item;\n      })\n    );\n  };\n\n  const handleAddNewGift = (newGift: GiftItem) => {\n    setGifts(prev => [newGift, ...prev]);\n  };\n\n  const handleAddRsvp = (newRsvp: RsvpSubmission) => {\n    setRsvps(prev => [newRsvp, ...prev]);\n    if (newRsvp.birthdayWish) {\n      setWishes(prev => [\n        {\n          id: `wish-${Date.now()}`,\n          sender: newRsvp.guestName,\n          message: newRsvp.birthdayWish,\n          sticker: \'\360\237\216\211\',\n          timestamp: \'Just now\',\n          likes: 1\n        },\n        ...prev\n      ]);\n    }\n  };\n\n  const handleAddWish = (newWish: BirthdayWish) => {\n    setWishes(prev => [newWish, ...prev]);\n  };\n\n  const handleLikeWish = (wishId: string) => {\n    setWishes(prev =>\n      prev.map(w => (w.id === wishId ? { ...w, likes: w.likes + 1 } : w))\n    );\n  };\n\n  const handleShareInvite = () => {\n    if (navigator.share) {\n      navigator.share({\n        title: `${party.celebrantName}\'s 5th Birthday Party Invitation!`,\n        text: `You\'re invited to ${party.celebrantName}\'s Gabby\'s Dollhouse Birthday Party! \360\237\220\261\342\234\250`,\n        url: window.location.href\n      }).catch(() => {});\n    } else {\n      navigator.clipboard.writeText(window.location.href);\n      setCopiedLink(true);\n      setTimeout(() => setCopiedLink(false), 2500);\n    }\n  };\n\n  const scrollToSection = (id: string) => {\n    const el = document.getElementById(id);\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  // 1. Initial Interactive Envelope Screen\n  if (!isOpened) {\n    return (\n      <InteractiveEnvelope\n        party={party}\n        onOpen={handleOpenEnvelope}\n      />\n    );\n  }\n\n  // 2. Main Mobile-First Birthday Invitation Website\n  return (\n    <div className=\"min-h-screen bg-gradient-to-b from-[#FFF0F6] via-[#F8F0FC] to-[#E6FFFA] text-slate-800 relative pb-24\">\n      {/* Background Dollhouse Sparkle Texture */}\n      <div className=\"fixed inset-0 dollhouse-dots opacity-30 pointer-events-none\" />\n\n      {/* Sticky Mobile Navigation Header */}\n      <header className=\"sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-pink-200 shadow-xs\">\n        <div className=\"max-w-md mx-auto px-4 py-2.5 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-lg\">\360\237\220\261</span>\n            <div>\n              <p className=\"text-xs font-bold font-heading text-slate-800 leading-tight\">\n                {party.celebrantName}&apos;s 5th Birthday!\n              </p>\n              <p className=\"text-[10px] text-pink-600 font-medium\">\n                {party.dateDisplay}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-1.5\">\n            {/* Replay Envelope */}\n            <button\n              onClick={handleReplayEnvelope}\n              className=\"p-1.5 rounded-xl text-slate-600 hover:text-pink-600 hover:bg-pink-50 transition-colors\"\n              title=\"Close and Replay Interactive Envelope\"\n            >\n              <RefreshCw className=\"w-4 h-4\" />\n            </button>\n\n            {/* Share / Copy Link */}\n            <button\n              onClick={handleShareInvite}\n              className=\"p-1.5 rounded-xl text-slate-600 hover:text-purple-600 hover:bg-purple-50 transition-colors\"\n              title=\"Share Invitation\"\n            >\n              {copiedLink ? <Check className=\"w-4 h-4 text-emerald-500\" /> : <Share2 className=\"w-4 h-4\" />}\n            </button>\n\n            {/* Edit / Customize Party */}\n            <button\n              onClick={() => setIsEditModalOpen(true)}\n              className=\"px-2.5 py-1 rounded-xl bg-pink-100/80 hover:bg-pink-200 text-pink-700 font-bold text-[11px] flex items-center gap-1 transition-colors\"\n              title=\"Customize celebrant name, photo, date, venue\"\n            >\n              <Settings className=\"w-3.5 h-3.5\" />\n              Edit\n            </button>\n          </div>\n        </div>\n\n        {/* Quick Navigation Quick Bar */}\n        <div className=\"max-w-md mx-auto px-4 py-1.5 flex items-center justify-between gap-1 overflow-x-auto border-t border-pink-100/60 text-[11px] font-bold no-scrollbar\">\n          <button\n            onClick={() => scrollToSection(\'countdown-section\')}\n            className=\"px-2 py-1 rounded-lg text-slate-600 hover:text-pink-600 hover:bg-pink-50 whitespace-nowrap transition-colors\"\n          >\n            \342\217\260 Countdown\n          </button>\n          <button\n            onClick={() => scrollToSection(\'venue-location-section\')}\n            className=\"px-2 py-1 rounded-lg text-slate-600 hover:text-purple-600 hover:bg-purple-50 whitespace-nowrap transition-colors\"\n          >\n            \360\237\223\215 Directions\n          </button>\n          <button\n            onClick={() => scrollToSection(\'gift-registry-section\')}\n            className=\"px-2 py-1 rounded-lg text-slate-600 hover:text-teal-600 hover:bg-teal-50 whitespace-nowrap transition-colors\"\n          >\n            \360\237\216\201 Gift Ideas\n          </button>\n          <button\n            onClick={() => scrollToSection(\'party-timeline-section\')}\n            className=\"px-2 py-1 rounded-lg text-slate-600 hover:text-pink-600 hover:bg-pink-50 whitespace-nowrap transition-colors\"\n          >\n            \360\237\216\210 Schedule\n          </button>\n          <button\n            onClick={() => scrollToSection(\'rsvp-section\')}\n            className=\"px-2 py-1 rounded-lg text-pink-600 bg-pink-50 hover:bg-pink-100 whitespace-nowrap transition-colors\"\n          >\n            \360\237\222\214 RSVP\n          </button>\n        </div>\n      </header>\n\n      {/* Main Content Area */}\n      <main className=\"max-w-md mx-auto relative z-10\">\n        {/* 1. Celebrant Hero Image & Profile */}\n        <HeroSection\n          party={party}\n          onRsvpClick={() => scrollToSection(\'rsvp-section\')}\n          onGiftsClick={() => scrollToSection(\'gift-registry-section\')}\n          onEditClick={() => setIsEditModalOpen(true)}\n        />\n\n        {/* 2. Live Countdown Timer */}\n        <CountdownTimer\n          targetDateIso={party.dateIso}\n          celebrantName={party.celebrantName}\n          celebrantAge={party.celebrantAge}\n        />\n\n        {/* 3. Venue Map Link & Directions */}\n        <VenueMapSection party={party} />\n\n        {/* 4. Gift Ideas Wishlist & Registry */}\n        <GiftRegistrySection\n          party={party}\n          gifts={gifts}\n          onToggleClaimGift={handleToggleClaimGift}\n          onAddNewGift={handleAddNewGift}\n        />\n\n        {/* 5. Party Timeline / Schedule */}\n        <PartyTimeline timeline={partyTimeline} />\n\n        {/* 6. Party Details (Dress Code & Food) */}\n        <PartyDetailsCard party={party} />\n\n        {/* 7. RSVP Section & Confirmed Guests */}\n        <RsvpSection\n          party={party}\n          rsvps={rsvps}\n          onSubmitRsvp={handleAddRsvp}\n        />\n\n        {/* 8. Wall of Wishes */}\n        <WishesWall\n          wishes={wishes}\n          celebrantName={party.celebrantName}\n          onAddWish={handleAddWish}\n          onLikeWish={handleLikeWish}\n        />\n\n        {/* Footer */}\n        <footer className=\"mt-8 px-4 text-center text-xs text-slate-500 space-y-2\">\n          <div className=\"flex items-center justify-center gap-1.5 text-pink-500 font-bold\">\n            <span>\342\234\250</span>\n            <span>A-Meow-Zing Gabby&apos;s Dollhouse Celebration</span>\n            <span>\342\234\250</span>\n          </div>\n          <p className=\"text-[11px] text-slate-400\">\n            Featuring Zootopia 2 soundtrack vibes &amp; Dollhouse magic\n          </p>\n        </footer>\n      </main>\n\n      {/* Floating Zootopia & Gabby Music Player */}\n      <MusicPlayer />\n\n      {/* Edit Party Customization Modal */}\n      <EditPartyModal\n        party={party}\n        isOpen={isEditModalOpen}\n        onClose={() => setIsEditModalOpen(false)}\n        onSave={(updated) => setParty(updated)}\n      />\n    </div>\n  );\n}"
      replacement_content: "import React, { useState, useEffect } from \'react\';\nimport { Sparkles, Heart, MapPin, Clock, Calendar, Mail, Settings, Share2, Music, Check, Volume2, RefreshCw } from \'lucide-react\';\nimport confetti from \'canvas-confetti\';\nimport { InteractiveEnvelope } from \'./components/InteractiveEnvelope\';\nimport { HeroSection } from \'./components/HeroSection\';\nimport { CountdownTimer } from \'./components/CountdownTimer\';\nimport { VenueMapSection } from \'./components/VenueMapSection\';\nimport { PartyTimeline } from \'./components/PartyTimeline\';\nimport { PartyDetailsCard } from \'./components/PartyDetailsCard\';\nimport { RsvpSection } from \'./components/RsvpSection\';\nimport { WishesWall } from \'./components/WishesWall\';\nimport { MusicPlayer } from \'./components/MusicPlayer\';\nimport { EditPartyModal } from \'./components/EditPartyModal\';\nimport { initialPartyDetails, partyTimeline, initialBirthdayWishes } from \'./data/partyData\';\nimport { PartyDetails, RsvpSubmission, BirthdayWish } from \'./types\';\nimport { audioEngine } from \'./utils/audioSynth\';\n\nexport default function App() {\n  const [isOpened, setIsOpened] = useState(false);\n  const [party, setParty] = useState<PartyDetails>(() => {\n    const saved = localStorage.getItem(\'gabby_party_details\');\n    return saved ? JSON.parse(saved) : initialPartyDetails;\n  });\n\n  const [rsvps, setRsvps] = useState<RsvpSubmission[]>(() => {\n    const saved = localStorage.getItem(\'gabby_party_rsvps\');\n    if (saved) return JSON.parse(saved);\n    return [\n      {\n        id: \'rsvp-1\',\n        guestName: \'The Miller Family\',\n        emailOrPhone: \'miller@example.com\',\n        attending: \'yes\',\n        adultsCount: 2,\n        kidsCount: 2,\n        kidsNames: \'Lily (5) & Toby (3)\',\n        dietaryRestrictions: \'None\',\n        birthdayWish: \'So excited to celebrate Mia!\',\n        submittedAt: \'Yesterday\'\n      },\n      {\n        id: \'rsvp-2\',\n        guestName: \'Auntie Chloe & Ben\',\n        emailOrPhone: \'555-443-2211\',\n        attending: \'yes\',\n        adultsCount: 2,\n        kidsCount: 0,\n        dietaryRestrictions: \'Vegetarian\',\n        birthdayWish: \'Happy birthday sweet Mia!\',\n        submittedAt: \'2 days ago\'\n      }\n    ];\n  });\n\n  const [wishes, setWishes] = useState<BirthdayWish[]>(() => {\n    const saved = localStorage.getItem(\'gabby_party_wishes\');\n    return saved ? JSON.parse(saved) : initialBirthdayWishes;\n  });\n\n  const [isEditModalOpen, setIsEditModalOpen] = useState(false);\n  const [copiedLink, setCopiedLink] = useState(false);\n\n  // Save to localStorage when updated\n  useEffect(() => {\n    localStorage.setItem(\'gabby_party_details\', JSON.stringify(party));\n  }, [party]);\n\n  useEffect(() => {\n    localStorage.setItem(\'gabby_party_rsvps\', JSON.stringify(rsvps));\n  }, [rsvps]);\n\n  useEffect(() => {\n    localStorage.setItem(\'gabby_party_wishes\', JSON.stringify(wishes));\n  }, [wishes]);\n\n  const handleOpenEnvelope = () => {\n    setIsOpened(true);\n  };\n\n  const handleReplayEnvelope = () => {\n    setIsOpened(false);\n  };\n\n  const handleAddRsvp = (newRsvp: RsvpSubmission) => {\n    setRsvps(prev => [newRsvp, ...prev]);\n    if (newRsvp.birthdayWish) {\n      setWishes(prev => [\n        {\n          id: `wish-${Date.now()}`,\n          sender: newRsvp.guestName,\n          message: newRsvp.birthdayWish,\n          sticker: \'\360\237\216\211\',\n          timestamp: \'Just now\',\n          likes: 1\n        },\n        ...prev\n      ]);\n    }\n  };\n\n  const handleAddWish = (newWish: BirthdayWish) => {\n    setWishes(prev => [newWish, ...prev]);\n  };\n\n  const handleLikeWish = (wishId: string) => {\n    setWishes(prev =>\n      prev.map(w => (w.id === wishId ? { ...w, likes: w.likes + 1 } : w))\n    );\n  };\n\n  const handleShareInvite = () => {\n    if (navigator.share) {\n      navigator.share({\n        title: `${party.celebrantName}\'s 5th Birthday Party Invitation!`,\n        text: `You\'re invited to ${party.celebrantName}\'s Gabby\'s Dollhouse Birthday Party! \360\237\220\261\342\234\250`,\n        url: window.location.href\n      }).catch(() => {});\n    } else {\n      navigator.clipboard.writeText(window.location.href);\n      setCopiedLink(true);\n      setTimeout(() => setCopiedLink(false), 2500);\n    }\n  };\n\n  const scrollToSection = (id: string) => {\n    const el = document.getElementById(id);\n    if (el) {\n      el.scrollIntoView({ behavior: \'smooth\' });\n    }\n  };\n\n  // 1. Initial Interactive Envelope Screen\n  if (!isOpened) {\n    return (\n      <InteractiveEnvelope\n        party={party}\n        onOpen={handleOpenEnvelope}\n      />\n    );\n  }\n\n  // 2. Main Mobile-First Birthday Invitation Website\n  return (\n    <div className=\"min-h-screen bg-gradient-to-b from-[#FFF0F6] via-[#F8F0FC] to-[#E6FFFA] text-slate-800 relative pb-24\">\n      {/* Background Dollhouse Sparkle Texture */}\n      <div className=\"fixed inset-0 dollhouse-dots opacity-30 pointer-events-none\" />\n\n      {/* Sticky Mobile Navigation Header */}\n      <header className=\"sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-pink-200 shadow-xs\">\n        <div className=\"max-w-md mx-auto px-4 py-2.5 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"text-lg\">\360\237\220\261</span>\n            <div>\n              <p className=\"text-xs font-bold font-heading text-slate-800 leading-tight\">\n                {party.celebrantName}&apos;s 5th Birthday!\n              </p>\n              <p className=\"text-[10px] text-pink-600 font-medium\">\n                {party.dateDisplay}\n              </p>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-1.5\">\n            {/* Replay Envelope */}\n            <button\n              onClick={handleReplayEnvelope}\n              className=\"p-1.5 rounded-xl text-slate-600 hover:text-pink-600 hover:bg-pink-50 transition-colors cursor-pointer\"\n              title=\"Close and Replay Interactive Envelope\"\n            >\n              <RefreshCw className=\"w-4 h-4\" />\n            </button>\n\n            {/* Share / Copy Link */}\n            <button\n              onClick={handleShareInvite}\n              className=\"p-1.5 rounded-xl text-slate-600 hover:text-purple-600 hover:bg-purple-50 transition-colors cursor-pointer\"\n              title=\"Share Invitation\"\n            >\n              {copiedLink ? <Check className=\"w-4 h-4 text-emerald-500\" /> : <Share2 className=\"w-4 h-4\" />}\n            </button>\n\n            {/* Edit / Customize Party */}\n            <button\n              onClick={() => setIsEditModalOpen(true)}\n              className=\"px-2.5 py-1 rounded-xl bg-pink-100/80 hover:bg-pink-200 text-pink-700 font-bold text-[11px] flex items-center gap-1 transition-colors cursor-pointer\"\n              title=\"Customize celebrant name, photo, date, venue\"\n            >\n              <Settings className=\"w-3.5 h-3.5\" />\n              Edit\n            </button>\n          </div>\n        </div>\n\n        {/* Quick Navigation Quick Bar */}\n        <div className=\"max-w-md mx-auto px-4 py-1.5 flex items-center justify-between gap-1 overflow-x-auto border-t border-pink-100/60 text-[11px] font-bold no-scrollbar\">\n          <button\n            onClick={() => scrollToSection(\'countdown-section\')}\n            className=\"px-2.5 py-1 rounded-lg text-slate-600 hover:text-pink-600 hover:bg-pink-50 whitespace-nowrap transition-colors cursor-pointer\"\n          >\n            \342\217\260 Countdown\n          </button>\n          <button\n            onClick={() => scrollToSection(\'venue-location-section\')}\n            className=\"px-2.5 py-1 rounded-lg text-slate-600 hover:text-purple-600 hover:bg-purple-50 whitespace-nowrap transition-colors cursor-pointer\"\n          >\n            \360\237\223\215 Directions\n          </button>\n          <button\n            onClick={() => scrollToSection(\'party-timeline-section\')}\n            className=\"px-2.5 py-1 rounded-lg text-slate-600 hover:text-pink-600 hover:bg-pink-50 whitespace-nowrap transition-colors cursor-pointer\"\n          >\n            \360\237\216\210 Schedule\n          </button>\n          <button\n            onClick={() => scrollToSection(\'party-details-card\')}\n            className=\"px-2.5 py-1 rounded-lg text-slate-600 hover:text-indigo-600 hover:bg-indigo-50 whitespace-nowrap transition-colors cursor-pointer\"\n          >\n            \360\237\221\227 Dress Code\n          </button>\n          <button\n            onClick={() => scrollToSection(\'rsvp-section\')}\n            className=\"px-3 py-1 rounded-lg text-pink-600 bg-pink-50 hover:bg-pink-100 whitespace-nowrap transition-colors cursor-pointer\"\n          >\n            \360\237\222\214 RSVP\n          </button>\n        </div>\n      </header>\n\n      {/* Main Content Area */}\n      <main className=\"max-w-md mx-auto relative z-10\">\n        {/* 1. Celebrant Hero Image & Profile */}\n        <HeroSection\n          party={party}\n          onRsvpClick={() => scrollToSection(\'rsvp-section\')}\n          onDirectionsClick={() => scrollToSection(\'venue-location-section\')}\n          onEditClick={() => setIsEditModalOpen(true)}\n        />\n\n        {/* 2. Live Countdown Timer */}\n        <CountdownTimer\n          targetDateIso={party.dateIso}\n          celebrantName={party.celebrantName}\n          celebrantAge={party.celebrantAge}\n        />\n\n        {/* 3. Venue Map Link & Directions */}\n        <VenueMapSection party={party} />\n\n        {/* 4. Party Timeline / Schedule */}\n        <PartyTimeline timeline={partyTimeline} />\n\n        {/* 5. Party Details (Dress Code & Food) */}\n        <PartyDetailsCard party={party} />\n\n        {/* 6. RSVP Section & Confirmed Guests */}\n        <RsvpSection\n          party={party}\n          rsvps={rsvps}\n          onSubmitRsvp={handleAddRsvp}\n        />\n\n        {/* 7. Wall of Wishes */}\n        <WishesWall\n          wishes={wishes}\n          celebrantName={party.celebrantName}\n          onAddWish={handleAddWish}\n          onLikeWish={handleLikeWish}\n        />\n\n        {/* Footer */}\n        <footer className=\"mt-8 px-4 text-center text-xs text-slate-500 space-y-2\">\n          <div className=\"flex items-center justify-center gap-1.5 text-pink-500 font-bold\">\n            <span>\342\234\250</span>\n            <span>A-Meow-Zing Gabby&apos;s Dollhouse Celebration</span>\n            <span>\342\234\250</span>\n          </div>\n          <p className=\"text-[11px] text-slate-400\">\n            Featuring Zootopia 2 soundtrack vibes &amp; Dollhouse magic\n          </p>\n        </footer>\n      </main>\n\n      {/* Floating Zootopia & Gabby Music Player */}\n      <MusicPlayer />\n\n      {/* Edit Party Customization Modal */}\n      <EditPartyModal\n        party={party}\n        isOpen={isEditModalOpen}\n        onClose={() => setIsEditModalOpen(false)}\n        onSave={(updated) => setParty(updated)}\n      />\n    </div>\n  );\n}"
    }
